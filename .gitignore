# The store never enters the repo. It lives at
# ~/.local/share/flatline-roundtable/roundtable.db; these entries are a second
# belt in case someone points --config here. Its secrets are encrypted, but it
# still holds internal hostnames and secret names.
*.db
*.db-wal
*.db-shm
# db restore keeps the replaced store as <name>.db.pre-restore-<stamp>.
*.db.pre-restore-*
backups/
# The retired YAML config, if an old copy is dropped here before import-yaml.
FlatlineRoundtable.yaml

# transcripts, if anyone points --config at a repo-local run
transcripts/

*.bak.*
*~
.DS_Store
# Playwright MCP session dumps (page snapshots, console logs, downloads).
.playwright-mcp/
__pycache__/
