def load_config(path: Path) -> dict:
    if not path.exists():
        die(
            f"no config at {path}\n"
            f"  copy FlatlineRoundtable.yaml.example there and edit it, "
            f"or pass --config PATH"
        )
    try:
        cfg = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as e:
        die(f"{path} is not valid YAML: {e}")
    if not isinstance(cfg.get("lanes"), list) or not cfg["lanes"]:
        die(f"{path} defines no lanes")

    defaults = cfg.get("defaults") or {}
    seen: set[str] = set()
    lanes = []
    for i, raw in enumerate(cfg["lanes"]):
        if not isinstance(raw, dict):
            die(f"lane #{i + 1} is not a mapping")
        lane = {**defaults, **raw}
        name = lane.get("name")
        if not name:
            die(f"lane #{i + 1} has no name")
        if name in seen:
            die(f"duplicate lane name {name!r} — names must be unique")
        seen.add(name)

        harness = lane.get("harness")
        if harness not in ("http", "cli", "acp"):
            die(f"{name}: harness must be 'http', 'cli' or 'acp', got {harness!r}")
        if harness == "http":
            for req in ("model", "base_url"):
                if not lane.get(req):
                    die(f"{name}: http lane needs {req}")
        elif harness == "acp":
            if not lane.get("command"):
                die(f"{name}: acp lane needs a command")
        else:
            if not lane.get("command"):
                die(f"{name}: cli lane needs a command")
            if not lane.get("args"):
                die(f"{name}: cli lane needs args (use '{{prompt}}' or stdin: true)")

        if lane.get("rpm") is not None:
            try:
                rpm = float(lane["rpm"])
            except (TypeError, ValueError):
                die(f"{name}: rpm must be a number, got {lane['rpm']!r}")
            if rpm <= 0:
                die(f"{name}: rpm must be greater than 0 (omit it for no pacing)")

        bad = EXTRA_BODY_DENY & set((lane.get("extra_body") or {}).keys())
        if bad:
            die(f"{name}: extra_body may not set {', '.join(sorted(bad))}")
        lanes.append(lane)
    cfg["lanes"] = lanes
    return cfg


# --------------------------------------------------------------------------- #
# secrets
# --------------------------------------------------------------------------- #
def fetch_keys(lanes: list[dict]) -> dict[str, str]:
    """Resolve every pass entry ONCE, before fan-out.

    Doing this inside the worker threads instead means N concurrent `pass show`
    calls hitting one gpg-agent. If the store is locked that either serialises
    behind a single pinentry or, in a non-tty context, storms and fails. Resolve
    up front, deduped, while we are still single-threaded and can report one
    clear error instead of N identical ones.
    """
    entries = {l["key_entry"] for l in lanes if l.get("key_entry")}
    if not entries:
        return {}
    if not shutil.which("pass"):
        die(
            "lanes reference pass entries but `pass` is not installed.\n"
            "  install it, or remove key_entry from those lanes"
        )
    keys: dict[str, str] = {}
    for entry in sorted(entries):
        try:
            p = subprocess.run(
                ["pass", "show", entry], capture_output=True, text=True, timeout=30
            )
        except subprocess.TimeoutExpired:
            die(f"`pass show {entry}` timed out — is gpg-agent waiting on a passphrase?")
        if p.returncode != 0:
            die(
                f"no pass entry {entry!r}\n"
                f"  create it with:  pass insert {entry}"
            )
        # pass returns the whole file; the secret is the first line. Taking the
        # blob would put trailing metadata into an Authorization header.
        first = p.stdout.splitlines()[0].strip() if p.stdout.strip() else ""
        if not first:
            die(f"pass entry {entry!r} is empty")
        keys[entry] = first
    return keys


class Pacer:
    """Spread one vendor's request *starts* to at least `interval` apart.

    The semaphore in `ask` bounds how many requests are in flight at once. That
    is a different quantity from how fast they arrive, and vendors meter the
    second one. Ten lanes dispatched together are ten requests in the same
    second even at concurrency 1, because each finishes and immediately frees
    the slot -- so a per-minute cap can be tripped before any 429 comes back to
    tell us about it.

    Retrying after a 429 is the reactive half and already exists. This is the
    proactive half: it costs a few seconds of wall clock and avoids burning a
    lane's retries on a limit we could have simply not hit.

    Bookkeeping happens under the lock; the sleep deliberately does not, so
    waiting threads do not serialise behind each other's sleeps.
    """

    def __init__(self, interval: float):
        self.interval = max(0.0, interval)
        self._lock = threading.Lock()
        self._next = 0.0

    def wait(self) -> float:
        """Block until this vendor's next slot. Returns seconds actually waited."""
        if not self.interval:
            return 0.0
        with self._lock:
            now = time.monotonic()
            start = max(now, self._next)
            self._next = start + self.interval
        delay = start - now
        if delay > 0:
            time.sleep(delay)
        return delay


def build_semaphores(lanes: list[dict], default_cc: int) -> dict[str, threading.Semaphore]:
    """One semaphore per vendor group, sized by the SMALLEST cap in the group.

    A single-slot local llama.cpp will queue every concurrent request past its
    own timeout if we fan out against it blindly, so the cap is load-bearing.

    Smallest, not first: this used to be a `setdefault`, which took whichever
    lane for that vendor appeared first in the YAML. A `concurrency: 1` lane
    listed second was silently ignored and the group ran at the default --
    reintroducing the exact failure the cap exists to prevent, decided by roster
    order. build_pacers already resolves rpm by minimum; this agrees with it.
    """
    caps: dict[str, int] = {}
    for l in lanes:
        gid = l.get("vendor") or l["name"]
        cc = int(l.get("concurrency", default_cc))
        caps[gid] = min(caps.get(gid, cc), cc)
    return {gid: threading.Semaphore(cc) for gid, cc in caps.items()}


def build_pacers(lanes: list[dict]) -> dict[str, Pacer]:
    """One Pacer per vendor group, keyed the same way the semaphores are.

    Where lanes in a group disagree on `rpm`, the smallest wins: the cap belongs
    to the vendor, not the lane, so the most conservative number is the only one
    that can be correct for all of them.
    """
    rpms: dict[str, float] = {}
    for l in lanes:
        rpm = l.get("rpm")
        if not rpm:
            continue
        gid = l.get("vendor") or l["name"]
        rpms[gid] = min(rpms.get(gid, float("inf")), float(rpm))
    return {gid: Pacer(60.0 / rpm) for gid, rpm in rpms.items()}


# --------------------------------------------------------------------------- #
# transport
# --------------------------------------------------------------------------- #
def http_lane(lane: dict, prompt: str, key: str | None, retries: int) -> dict:
    body = {
        "model": lane["model"],
        "max_tokens": lane.get("max_tokens", 2000),
        "messages": (
            ([{"role": "system", "content": lane["personality"]}] if lane.get("personality") else [])
            + [{"role": "user", "content": prompt}]
        ),
    }
    if lane.get("temperature") is not None:
        body["temperature"] = lane["temperature"]
    body.update(lane.get("extra_body") or {})

    url = lane["base_url"].rstrip("/") + "/chat/completions"
    headers = {"Content-Type": "application/json"}
    if key:
        # In-process only. Never argv -- argv is world-readable via ps.
        headers["Authorization"] = f"Bearer {key}"

    attempt = 0
    while True:
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=lane.get("timeout", 300)) as r:
                data = json.load(r)
            # A 200 carrying an error body is how an upstream failure arrives when
            # the gateway itself succeeded -- "Upstream error from Nvidia" on a
            # free endpoint under load. No completion was produced, so nothing
            # billed and another attempt is safe. Previously this raised straight
            # out of the retry loop, so the single most common free-lane failure
            # was the one failure that never got a second try.
            if "error" in data:
                if attempt < retries:
                    attempt += 1
                    time.sleep(RETRY_BACKOFF * attempt)
                    continue
                raise RuntimeError(str(data["error"])[:300])
            choice = data["choices"][0]
            answer = (choice["message"].get("content") or "").strip()
            # An empty body is a lane that delivered nothing, which fails the whole
            # run -- and free endpoints return it under load (measured: 1 call in 6
            # on one provider, 1 completion token, finish_reason "stop"). The dead
            # call billed its prompt only, so a retry is far cheaper than losing
            # the lane. It IS a second charge on a metered lane, so it is bounded
            # by `retries` exactly like every other path here.
            if not answer and attempt < retries:
                attempt += 1
                time.sleep(RETRY_BACKOFF * attempt)
                continue
            return {
                "answer": answer,
                "finish_reason": choice.get("finish_reason"),
                "served_by": data.get("provider"),
                "usage": data.get("usage"),
            }
        except urllib.error.HTTPError as e:
            retry_after = e.headers.get("Retry-After") if e.headers else None
            transient = e.code >= 500 or e.code == 429
            if transient and attempt < retries:
                attempt += 1
                # Honour Retry-After rather than hammering a rate-limited vendor.
                time.sleep(min(float(retry_after), RETRY_AFTER_CAP)
                           if retry_after and retry_after.isdigit() else RETRY_BACKOFF * attempt)
                continue
            raise RuntimeError(f"HTTP {e.code}: {e.read()[:200].decode(errors='replace')}") from None
        except urllib.error.URLError as e:
            if attempt < retries:
                attempt += 1
                time.sleep(RETRY_BACKOFF * attempt)
                continue
            raise RuntimeError(f"connection failed: {e.reason}") from None
        except TimeoutError:
            # Deliberately NOT retried. The request may well have completed and
            # billed on the vendor side; a blind retry double-charges a metered
            # lane to produce an answer we already paid for.
            raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s") from None


def cli_lane(lane: dict, prompt: str) -> dict:
    """Run a subscription-backed CLI in one-shot mode.

    Two things here are not decoration:

    1. The child gets a scrubbed environment (see SCRUB_ENV) so an API key in the
       ambient shell cannot silently convert this free lane into a billed one.
    2. start_new_session=True puts the child in its own process group so a
       timeout can kill the whole tree. A plain subprocess timeout leaves a hung
       CLI (or one sitting at a login prompt) orphaned and running -- which is
       precisely the failure this tool was built to eliminate.
    """
    env = {k: v for k, v in os.environ.items() if k not in SCRUB_ENV}
    env["NO_COLOR"] = "1"

    cmd, stdin_text = [], None
    for arg in lane["args"]:
        if arg == "{prompt}":
            cmd.append(prompt)
        elif arg == "{personality}":
            cmd.append(lane.get("personality", ""))
        else:
            cmd.append(arg)
    if lane.get("stdin"):
        stdin_text = prompt
        cmd = [a for a in cmd if a != prompt]
    if lane.get("personality") and not any("{personality}" in a for a in lane["args"]):
        text = f"{lane['personality']}\n\n---\n\n{prompt}"
        if stdin_text is not None:
            stdin_text = text
        else:
            cmd = [lane["personality"] + "\n\n---\n\n" + a if a == prompt else a for a in cmd]

    proc = subprocess.Popen(
        [lane["command"], *cmd],
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(stdin_text, timeout=lane.get("timeout", 300))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        proc.wait(timeout=10)
        raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s (process group killed)") from None

    if proc.returncode != 0:
        raise RuntimeError(f"{lane['command']} exit {proc.returncode}: {err.strip()[:200]}")
    # Shell profiles and CLI update banners pollute stdout. Drop obvious
    # non-answer noise rather than trusting the stream to be clean.
    lines = [l for l in out.splitlines() if not l.strip().startswith(("🕐", "\x1b"))]
    text = "\n".join(lines).strip()
    if not text:
        raise RuntimeError("produced no output")
    return {"answer": text, "finish_reason": "stop", "served_by": lane["command"], "usage": None}


# --------------------------------------------------------------------------- #
# run
# --------------------------------------------------------------------------- #
def acp_lane(lane: dict, prompt: str) -> dict:
    """Drive an ACP (Agent Client Protocol) agent for exactly one turn.

    Some assistants expose no one-shot print mode -- only JSON-RPC over stdio.
    This does the minimum exchange to get one answer:

        initialize -> session/new -> session/prompt -> collect updates -> kill

    The process is created for this turn and killed at the end of it, in its own
    process group. That is the whole point: an ACP agent is a SERVER and will sit
    there indefinitely if you let it, which is precisely the long-lived-process
    failure this tool exists to avoid. Do not "optimise" this by reusing a
    session across lanes or keeping the process warm.
    """
    env = {k: v for k, v in os.environ.items() if k not in SCRUB_ENV}
    env["NO_COLOR"] = "1"
    proc = subprocess.Popen(
        [lane["command"], *(lane.get("args") or [])],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1, env=env, start_new_session=True,
    )
    lk, replies, chunks = threading.Lock(), {}, []

    def reader():
        try:
            for line in proc.stdout:
                try:
                    m = json.loads(line)
                except (ValueError, TypeError):
                    continue          # agents emit non-JSON banners on stdout
                if "id" in m and ("result" in m or "error" in m):
                    with lk:
                        replies[m["id"]] = m
                elif m.get("method") == "session/update":
                    u = (m.get("params") or {}).get("update") or {}
                    if u.get("sessionUpdate") == "agent_message_chunk":
                        t = (u.get("content") or {}).get("text")
                        if t:
                            chunks.append(t)
        except (ValueError, OSError):
            pass                       # stream closed under us on kill

    threading.Thread(target=reader, daemon=True).start()
    deadline = time.time() + lane.get("timeout", 300)

    def call(rid, method, params):
        proc.stdin.write(json.dumps(
            {"jsonrpc": "2.0", "id": rid, "method": method, "params": params}) + "\n")
        proc.stdin.flush()
        while time.time() < deadline:
            with lk:
                if rid in replies:
                    return replies[rid]
            if proc.poll() is not None:
                raise RuntimeError(f"{lane['command']} exited during {method}")
            time.sleep(0.05)
        raise RuntimeError(f"timed out waiting for {method}")

    try:
        call(0, "initialize", {"protocolVersion": lane.get("protocol_version", 1),
                               "clientCapabilities": {"fs": {"readTextFile": False,
                                                             "writeTextFile": False}}})
        r = call(1, "session/new", {"cwd": os.getcwd(), "mcpServers": []})
        sid = (r.get("result") or {}).get("sessionId")
        if not sid:
            raise RuntimeError(f"session/new returned no sessionId: {str(r)[:150]}")
        text = prompt
        if lane.get("personality"):
            text = f"{lane['personality']}\n\n---\n\n{prompt}"
        r = call(2, "session/prompt",
                 {"sessionId": sid, "prompt": [{"type": "text", "text": text}]})
        if "error" in r:
            raise RuntimeError(str(r["error"])[:200])
        stop = (r.get("result") or {}).get("stopReason")
        answer = "".join(chunks).strip()
        if not answer:
            raise RuntimeError(f"no agent_message_chunk received (stopReason={stop})")
        return {"answer": answer,
                "finish_reason": "length" if stop == "max_tokens" else "stop",
                "served_by": lane["command"], "usage": None}
    finally:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            pass


def ask(lane, prompt, keys, retries, deadline, sems, lock, spent, prices, pacers=None):
    started = time.time()
    result = {
        "lane": lane["name"],
        "model": lane.get("model"),
        "vendor": lane.get("vendor"),
        "harness": lane["harness"],
        "answer": None,
        "error": None,
        "finish_reason": None,
    }
    sem = sems.get(lane.get("vendor") or lane["name"])
    try:
        if deadline and time.time() > deadline:
            raise RuntimeError("global deadline passed before dispatch")
        pacer = (pacers or {}).get(lane.get("vendor") or lane["name"])
        if pacer:
            result["paced_s"] = round(pacer.wait(), 2)
            # Pacing can push a lane past a deadline that it was inside when the
            # run started. Re-check rather than dispatching a request whose
            # answer we have already decided not to wait for.
            if deadline and time.time() > deadline:
                raise RuntimeError("global deadline passed while pacing")
        with sem:
            if lane["harness"] == "acp":
                out = acp_lane(lane, prompt)
            elif lane["harness"] == "cli":
                out = cli_lane(lane, prompt)
            else:
                key = keys.get(lane["key_entry"]) if lane.get("key_entry") else None
                out = http_lane(lane, prompt, key, retries)
        result.update(out)
        if not result["answer"]:
            result["error"] = "empty answer"
        # A clipped answer is a silent failure: it reads as complete and is not.
        if result.get("finish_reason") == "length":
            result["truncated"] = True
        # Charge prompt and completion separately: completion is typically 2-4x
        # the prompt rate, so a blended per-token figure understates a long answer.
        pin, pout = prices
        u = out.get("usage") or {}
        if (pin or pout) and u:
            cost = (u.get("prompt_tokens") or 0) * pin + (u.get("completion_tokens") or 0) * pout
            result["cost"] = round(cost, 6)
            with lock:
                spent[0] += cost
    except Exception as e:  # noqa: BLE001 — a lane failing must never kill the run
        result["error"] = str(e)
    result["seconds"] = round(time.time() - started, 1)
    return result


SYNTH_PROMPT = """Below are {n} independent answers to the same question, each from a
different model that could not see the others.

Report ONLY:
1. AGREED — points where they independently land in the same place.
2. SPLIT — points of genuine disagreement. For each, say WHO takes which side and
   WHY they differ (different assumption, different priority, different reading).
3. LONE CLAIMS — anything asserted by exactly one lane that the others neither
   support nor contradict. Flag any that look like invented specifics.

Do not summarise the answers. Do not add your own opinion on the question.
If they substantially agree, say so in one line rather than manufacturing a split.

--- THE QUESTION ---
{brief}

--- THE ANSWERS ---
{answers}"""


SYNTH_SECTIONS = ("AGREED", "SPLIT", "LONE CLAIMS")


def pick_synthesizers(lanes, want, n):
    """Choose up to n readers, preferring free lanes from *different* vendors.

    Vendor spread is the point: two readings from one lineage share the priors
    that make a single reading untrustworthy, so they would agree for the same
    reason rather than independently.
    """
    named = [l for l in lanes if l["name"] == want] if want else []
    pool = [l for l in lanes if l["name"] != want]

    def rank(l):
        # cli rides a subscription; :free costs nothing; everything else bills.
        return (0 if l["harness"] == "cli"
                else 1 if str(l.get("model", "")).endswith(":free")
                else 2)

    chosen, used_vendors = list(named), {l.get("vendor") for l in named}
    for lane in sorted(pool, key=rank):
        if len(chosen) >= n:
            break
        if lane.get("vendor") in used_vendors:
            continue
        chosen.append(lane)
        used_vendors.add(lane.get("vendor"))
    # Only if vendor spread could not fill the quota, allow a repeat vendor --
    # two readings still beat one, even correlated ones.
    for lane in sorted(pool, key=rank):
        if len(chosen) >= n:
            break
        if lane not in chosen:
            chosen.append(lane)
    return chosen[:n]


def classify_mentions(text, lane_names):
    """Which section of a reading each lane is named under.

    Deliberately mechanical. Comparing two readings with a third model would
    reintroduce exactly the problem this is meant to expose -- another single
    model's priors deciding what counts as a difference.
    """
    if not text:
        return {}
    upper = text.upper()
    marks = sorted(
        ((upper.find(sec), sec) for sec in SYNTH_SECTIONS if upper.find(sec) >= 0)
    )
    if not marks:
        return {}
    bounds = []
    for i, (pos, sec) in enumerate(marks):
        end = marks[i + 1][0] if i + 1 < len(marks) else len(text)
        bounds.append((sec, upper[pos:end]))
    out = {}
    for name in lane_names:
        hits = {sec for sec, chunk in bounds if name.upper() in chunk}
        if hits:
            out[name] = sorted(hits)
    return out


def compare_readings(readings, lane_names):
    """Where the readers disagree about a lane's classification."""
    if len(readings) < 2:
        return []
    maps = [(r["by"], classify_mentions(r.get("text"), lane_names)) for r in readings]
    conflicts = []
    for name in lane_names:
        placements = {by: m.get(name) for by, m in maps}
        distinct = {tuple(v) for v in placements.values() if v}
        if len(distinct) > 1:
            conflicts.append({"lane": name, "placements": placements})
    return conflicts


def synthesize(results, brief, cfg, lanes, keys, prices, count=2):
    """Ask N lanes to report where the others diverged (issues #6, #8).

    Reading N full answers does not scale, and disagreement is the actual
    product. This is opt-in because it is NOT neutral: a synthesizer is itself
    one model with its own priors deciding what counts as a disagreement. It is
    a reading aid, not a verdict -- which is why the raw answers are still
    written to the transcript.

    Two readers rather than one, because a single reading hides its own bias:
    with one you cannot tell a real split from that model's taste in splits.
    Where two independent readers place the same lane differently, the reading
    is doing the work rather than the evidence. That comparison is mechanical on
    purpose -- handing it to a third model would just move the problem.

    Prefers free lanes so the convenience does not quietly cost money.
    """
    answered = [r for r in results if r.get("answer")]
    if len(answered) < 2:
        return None, "need at least 2 answers to compare"

    chosen = pick_synthesizers(lanes, cfg.get("synthesizer"), max(1, int(count)))
    if not chosen:
        return None, "no lane available to synthesize"

    body = "\n\n".join(f"### {r['lane']} ({r['model'] or r['harness']})\n{r['answer']}"
                        for r in answered)
    ask_text = SYNTH_PROMPT.format(n=len(answered), brief=brief.strip()[:4000], answers=body)

    def read(lane):
        synth_lane = {**lane, "max_tokens": max(int(lane.get("max_tokens", 2000)), 1500),
                      "personality": None}
        if synth_lane["harness"] == "cli":
            out = cli_lane(synth_lane, ask_text)
        elif synth_lane["harness"] == "acp":
            out = acp_lane(synth_lane, ask_text)
        else:
            key = keys.get(synth_lane["key_entry"]) if synth_lane.get("key_entry") else None
            out = http_lane(synth_lane, ask_text, key, 1)
        return {"by": lane["name"], "text": out["answer"]}

    readings, errors = [], []
    with cf.ThreadPoolExecutor(max_workers=len(chosen)) as pool:
        for lane, fut in [(l, pool.submit(read, l)) for l in chosen]:
            try:
                readings.append(fut.result())
            except Exception as e:
                errors.append(f"{lane['name']}: {e}")

    if not readings:
        return None, f"synthesis failed ({'; '.join(errors)})"

    names = [r["lane"] for r in answered]
    return {
        "readings": readings,
        "conflicts": compare_readings(readings, names),
        "errors": errors,
    }, None


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("brief", nargs="*")
    ap.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    ap.add_argument("--lanes")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-spend", type=float)
    ap.add_argument("--no-transcript", action="store_true")
    ap.add_argument("--diff", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip())
        return 0

    cfg = load_config(a.config)
    lanes = [l for l in cfg["lanes"] if l.get("active", True)]
    if a.lanes:
        want = {n.strip().lower() for n in a.lanes.split(",")}
        lanes = [l for l in lanes if l["name"].lower() in want]
        if not lanes:
            die(f"--lanes matched nothing in {a.config}")

    if a.list:
        for l in lanes:
            route = l["harness"]
            where = l.get("base_url") or l.get("command") or ""
            print(f"  [{route:<4}] {l['name']:<18} {str(l.get('vendor') or '-'):<14} "
                  f"{str(l.get('model') or '-'):<42} {where}")
        print(f"\n  {len(lanes)} active lane(s). No calls made.")
        return 0

    prompt = sys.stdin.read() if a.brief[:1] == ["-"] else " ".join(a.brief)
    if not prompt.strip():
        die("empty brief")

    budget = a.max_spend if a.max_spend is not None else cfg.get("budget_usd")
    deadline = time.time() + cfg["deadline_seconds"] if cfg.get("deadline_seconds") else None
    keys = fetch_keys(lanes)
    prices = load_pricing(lanes)

    # Refuse BEFORE spending, not after. A budget checked only on the way out
    # reports an overrun; it does not prevent one.
    calib = load_calibration()
    estimate = estimate_run(lanes, prompt, prices, cfg.get("defaults") or {}, calib)
    if budget is not None and estimate > budget:
        die(
            f"estimated worst case ${estimate:.4f} exceeds budget ${budget:.2f} — refusing to dispatch\n"
            f"  raise --max-spend, drop lanes with --lanes, or lower max_tokens"
        )

    sems = build_semaphores(lanes, int(cfg.get("concurrency", 8)))
    # Concurrency bounds how many are in flight; rpm bounds how fast they start.
    pacers = build_pacers(lanes)

    lock, spent = threading.Lock(), [0.0]
    t0 = time.time()
    with cf.ThreadPoolExecutor(max_workers=max(len(lanes), 1)) as pool:
        results = list(pool.map(
            lambda l: ask(l, prompt, keys, int(cfg.get("retries", 1)), deadline, sems, lock,
                          spent, lane_prices(l, prices), pacers),
            lanes,
        ))

    answered = [r for r in results if r["answer"]]

    # Fold this run's real prompt_tokens back in, so the next pre-flight
    # estimate is measured rather than assumed.
    record_calibration(results, prompt, lanes)

    synth = None
    if a.diff:
        synth, synth_err = synthesize(results, prompt, cfg, lanes, keys, prices,
                                      count=int(cfg.get("synthesizers", 2)))

    if not a.no_transcript:
        TRANSCRIPT_DIR.mkdir(parents=True, exist_ok=True)
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        path = TRANSCRIPT_DIR / f"{stamp}.json"
        path.write_text(json.dumps(
            {"brief": prompt, "results": results, "synthesis": synth}, indent=2))

    if a.json:
        print(json.dumps({"results": results, "synthesis": synth} if a.diff else results, indent=2))
    elif a.diff:
        if synth:
            for r in synth["readings"]:
                print(f"\n{'=' * 74}\nWHERE THEY DIVERGE  (read by {r['by']})\n{'=' * 74}")
                print(r["text"])
            # Two readers exist so the reading's own bias is visible. Where they
            # place the same lane differently, that is the synthesizer talking,
            # not the panel -- go read that lane's raw answer.
            if synth["conflicts"]:
                print(f"\n{'=' * 74}\nTHE READERS DISAGREE\n{'=' * 74}")
                for c in synth["conflicts"]:
                    where = "  ".join(
                        f"{by}={'/'.join(sec) if sec else 'unmentioned'}"
                        for by, sec in c["placements"].items()
                    )
                    print(f"  {c['lane']:<18} {where}")
                print("\n  These are classification disputes between the readers, not\n"
                      "  findings. Read those lanes' raw answers in the transcript.")
            elif len(synth["readings"]) > 1:
                print(f"\n  Both readers classified every lane the same way.")
            for e in synth.get("errors") or []:
                print(f"\n  !! reader failed — {e}", file=sys.stderr)
            n = len(synth["readings"])
            print(f"\n  -- {n} lane{'s' if n != 1 else ''} reading the others, not a verdict."
                  f" raw answers in the transcript.")
        else:
            print(f"\n  !! {synth_err}", file=sys.stderr)
    else:
        for r in results:
            print(f"\n{'=' * 74}\n{r['lane']}  ({r['model'] or r['harness']})  {r['seconds']}s")
            print("=" * 74)
            print(r["answer"] if r["answer"] else f"  !! {r['error']}")
            if r.get("truncated"):
                print("\n  !! TRUNCATED — hit max_tokens; raise it for this lane")
        print(f"\n{'=' * 74}")
        print(f"{len(answered)}/{len(results)} lanes answered in {time.time() - t0:.1f}s")
        if spent[0] or estimate:
            print(f"spend: ${spent[0]:.4f} actual  (est. worst case ${estimate:.4f})")
        if not a.no_transcript:
            print(f"transcript: {path}")
        for r in results:
            if not r["answer"]:
                print(f"  FAILED  {r['lane']}: {r['error']}")

    # Backstop only -- the pre-flight gate above is what actually protects the
    # budget. This catches an estimate that was too optimistic.
    if budget is not None and spent[0] > budget:
        print(f"\n!! spend ${spent[0]:.4f} exceeded budget ${budget:.2f}", file=sys.stderr)
        return 2
    # A silent lane is the bug this tool exists to eliminate, so partial
    # delivery is a failure, not a pass.
    return 0 if len(answered) == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
