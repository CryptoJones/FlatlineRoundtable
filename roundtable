def load_config(path: Path) -> dict:
    if not path.exists():
        die(
            f"no config at {path}\n"
            f"  copy FlatlineRoundtable.yaml.example there and edit it, "
            f"or pass --config PATH"
        )
    try:
        cfg = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as e:
        die(f"{path} is not valid YAML: {e}")
    if not isinstance(cfg.get("lanes"), list) or not cfg["lanes"]:
        die(f"{path} defines no lanes")

    defaults = cfg.get("defaults") or {}
    seen: set[str] = set()
    lanes = []
    for i, raw in enumerate(cfg["lanes"]):
        if not isinstance(raw, dict):
            die(f"lane #{i + 1} is not a mapping")
        lane = {**defaults, **raw}
        name = lane.get("name")
        # YAML 1.1 reads Off/No as False and Yes/On as True, so an unquoted
        # lane called `Off` arrives here as a boolean and the truthiness check
        # below reported "has no name" -- an error naming neither the cause nor
        # the fix, for a plausible name for a parked lane.
        if name is not None and not isinstance(name, str):
            # The original text is already gone -- the parser handed us a bool --
            # so name the rule rather than echoing a useless {name!r}.
            die(f"lane #{i + 1}: name must be a string, got the boolean {name!r}. "
                f"YAML reads Off/No as false and Yes/On as true; "
                f"quote the name to keep it a string.")
        if not name:
            die(f"lane #{i + 1} has no name")
        if name in seen:
            die(f"duplicate lane name {name!r} — names must be unique")
        seen.add(name)

        harness = lane.get("harness")
        if harness not in ("http", "cli", "acp"):
            die(f"{name}: harness must be 'http', 'cli' or 'acp', got {harness!r}")
        if harness == "http":
            for req in ("model", "base_url"):
                if not lane.get(req):
                    die(f"{name}: http lane needs {req}")
        elif harness == "acp":
            if not lane.get("command"):
                die(f"{name}: acp lane needs a command")
        else:
            if not lane.get("command"):
                die(f"{name}: cli lane needs a command")
            if not lane.get("args"):
                die(f"{name}: cli lane needs args (use '{{prompt}}' or stdin: true)")
            # The line above only proved args is non-empty. Without one of these
            # two, the brief is never delivered: cmd carries no prompt, stdin is
            # DEVNULL, and the personality-prepend finds nothing to attach to.
            # The dangerous outcome is not the CLI erroring -- that fails loudly.
            # It is a CLI that answers an empty prompt with something plausible,
            # producing a lane that counts as a vote without having seen the
            # question.
            if "{prompt}" not in lane["args"] and not lane.get("stdin"):
                die(f"{name}: cli lane would send no prompt — "
                    f"put '{{prompt}}' in args, or set stdin: true")

        if lane.get("lineage") is not None and not isinstance(lane["lineage"], str):
            die(f"{name}: lineage must be a string naming a model family")

        if lane.get("rpm") is not None:
            try:
                rpm = float(lane["rpm"])
            except (TypeError, ValueError):
                die(f"{name}: rpm must be a number, got {lane['rpm']!r}")
            if rpm <= 0:
                die(f"{name}: rpm must be greater than 0 (omit it for no pacing)")

        bad = EXTRA_BODY_DENY & set((lane.get("extra_body") or {}).keys())
        if bad:
            die(f"{name}: extra_body may not set {', '.join(sorted(bad))}")
        lanes.append(lane)
    cfg["lanes"] = lanes
    return cfg


# --------------------------------------------------------------------------- #
# secrets
# --------------------------------------------------------------------------- #
def fetch_keys(lanes: list[dict]) -> dict[str, str]:
    """Resolve every pass entry ONCE, before fan-out.

    Doing this inside the worker threads instead means N concurrent `pass show`
    calls hitting one gpg-agent. If the store is locked that either serialises
    behind a single pinentry or, in a non-tty context, storms and fails. Resolve
    up front, deduped, while we are still single-threaded and can report one
    clear error instead of N identical ones.
    """
    entries = {l["key_entry"] for l in lanes if l.get("key_entry")}
    if not entries:
        return {}
    if not shutil.which("pass"):
        die(
            "lanes reference pass entries but `pass` is not installed.\n"
            "  install it, or remove key_entry from those lanes"
        )
    keys: dict[str, str] = {}
    for entry in sorted(entries):
        try:
            p = subprocess.run(
                ["pass", "show", entry], capture_output=True, text=True, timeout=30
            )
        except subprocess.TimeoutExpired:
            die(f"`pass show {entry}` timed out — is gpg-agent waiting on a passphrase?")
        if p.returncode != 0:
            die(
                f"no pass entry {entry!r}\n"
                f"  create it with:  pass insert {entry}"
            )
        # pass returns the whole file; the secret is the first line. Taking the
        # blob would put trailing metadata into an Authorization header.
        first = p.stdout.splitlines()[0].strip() if p.stdout.strip() else ""
        if not first:
            die(f"pass entry {entry!r} is empty")
        keys[entry] = first
    return keys


class Pacer:
    """Spread one vendor's request *starts* to at least `interval` apart.

    The semaphore in `ask` bounds how many requests are in flight at once. That
    is a different quantity from how fast they arrive, and vendors meter the
    second one. Ten lanes dispatched together are ten requests in the same
    second even at concurrency 1, because each finishes and immediately frees
    the slot -- so a per-minute cap can be tripped before any 429 comes back to
    tell us about it.

    Retrying after a 429 is the reactive half and already exists. This is the
    proactive half: it costs a few seconds of wall clock and avoids burning a
    lane's retries on a limit we could have simply not hit.

    Bookkeeping happens under the lock; the sleep deliberately does not, so
    waiting threads do not serialise behind each other's sleeps.
    """

    def __init__(self, interval: float):
        self.interval = max(0.0, interval)
        self._lock = threading.Lock()
        self._next = 0.0

    def wait(self) -> float:
        """Block until this vendor's next slot. Returns seconds actually waited."""
        if not self.interval:
            return 0.0
        with self._lock:
            now = time.monotonic()
            start = max(now, self._next)
            self._next = start + self.interval
        delay = start - now
        if delay > 0:
            time.sleep(delay)
        return delay


def build_semaphores(lanes: list[dict], default_cc: int) -> dict[str, threading.Semaphore]:
    """One semaphore per vendor group, sized by the SMALLEST cap in the group.

    A single-slot local llama.cpp will queue every concurrent request past its
    own timeout if we fan out against it blindly, so the cap is load-bearing.

    Smallest, not first: this used to be a `setdefault`, which took whichever
    lane for that vendor appeared first in the YAML. A `concurrency: 1` lane
    listed second was silently ignored and the group ran at the default --
    reintroducing the exact failure the cap exists to prevent, decided by roster
    order. build_pacers already resolves rpm by minimum; this agrees with it.
    """
    caps: dict[str, int] = {}
    for l in lanes:
        gid = l.get("vendor") or l["name"]
        cc = int(l.get("concurrency", default_cc))
        caps[gid] = min(caps.get(gid, cc), cc)
    return {gid: threading.Semaphore(cc) for gid, cc in caps.items()}
def lineage_collisions(results: list[dict], lanes: list[dict]) -> list[dict]:
    """Lanes that answered from the same place, and so do not vote independently.

    The product claim is that convergence between independently-trained models
    is evidence. Every other guard in this tool protects the plumbing of that
    claim -- the cost gates, the orphan kills, the partial-delivery exit --
    while nothing protected the claim itself.

    A gateway routes one model string to whatever provider is cheapest at that
    moment, and a roster can name the same model twice by accident. When either
    happens the panel reports agreement and the agreement is an echo.

    Two lanes collide when they resolved to the same (served_by, model), or when
    they declare the same `lineage:`. Reported, never fatal: a deliberate
    duplicate is a legitimate thing to want, it just must not be silent.
    """
    by_name = {l["name"]: l for l in lanes}
    groups: dict[tuple, list[str]] = {}
    for r in results:
        if not r.get("answer"):
            continue
        lane = by_name.get(r.get("lane")) or {}
        lineage = lane.get("lineage")
        # A declared lineage is the operator's own claim and outranks whatever
        # the gateway happened to report.
        key = (("lineage", lineage) if lineage
               else ("served", r.get("served_by"), r.get("model")))
        if key[1] is None:
            continue
        groups.setdefault(key, []).append(r["lane"])
    out = []
    for key, names in groups.items():
        if len(names) < 2:
            continue
        out.append({
            "lanes": sorted(names),
            "kind": key[0],
            "detail": key[1] if key[0] == "lineage" else f"{key[1]} / {key[2]}",
        })
    return sorted(out, key=lambda c: c["lanes"])


def build_pacers(lanes: list[dict]) -> dict[str, Pacer]:
    """One Pacer per vendor group, keyed the same way the semaphores are.

    Where lanes in a group disagree on `rpm`, the smallest wins: the cap belongs
    to the vendor, not the lane, so the most conservative number is the only one
    that can be correct for all of them.
    """
    rpms: dict[str, float] = {}
    for l in lanes:
        rpm = l.get("rpm")
        if not rpm:
            continue
        gid = l.get("vendor") or l["name"]
        rpms[gid] = min(rpms.get(gid, float("inf")), float(rpm))
    return {gid: Pacer(60.0 / rpm) for gid, rpm in rpms.items()}


# --------------------------------------------------------------------------- #
# transport
# --------------------------------------------------------------------------- #
def parse_retry_after(value: str | None) -> float | None:
    """Seconds to wait, from a Retry-After header, or None if it says nothing.

    The header has two legal forms and the previous `.isdigit()` test accepted
    neither reliably: "1.5" is not all digits, and the HTTP-date form is not
    either, so both silently fell back to the default backoff -- under a comment
    promising the vendor's own number would be honoured.
    """
    if not value:
        return None
    value = value.strip()
    try:
        return max(0.0, float(value))
    except ValueError:
        pass
    try:
        when = email.utils.parsedate_to_datetime(value)
    except (TypeError, ValueError):
        return None
    if when is None:
        return None
    if when.tzinfo is None:
        when = when.replace(tzinfo=dt.timezone.utc)
    return max(0.0, (when - dt.datetime.now(dt.timezone.utc)).total_seconds())


def http_lane(lane: dict, prompt: str, key: str | None, retries: int) -> dict:
    body = {
        "model": lane["model"],
        "max_tokens": lane.get("max_tokens", 2000),
        "messages": (
            ([{"role": "system", "content": lane["personality"]}] if lane.get("personality") else [])
            + [{"role": "user", "content": prompt}]
        ),
    }
    if lane.get("temperature") is not None:
        body["temperature"] = lane["temperature"]
    body.update(lane.get("extra_body") or {})

    url = lane["base_url"].rstrip("/") + "/chat/completions"
    headers = {"Content-Type": "application/json"}
    if key:
        # In-process only. Never argv -- argv is world-readable via ps.
        headers["Authorization"] = f"Bearer {key}"

    attempt = 0
    while True:
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=lane.get("timeout", 300)) as r:
                data = json.load(r)
            # A 200 carrying an error body is how an upstream failure arrives when
            # the gateway itself succeeded -- "Upstream error from Nvidia" on a
            # free endpoint under load. No completion was produced, so nothing
            # billed and another attempt is safe. Previously this raised straight
            # out of the retry loop, so the single most common free-lane failure
            # was the one failure that never got a second try.
            if "error" in data:
                if attempt < retries:
                    attempt += 1
                    time.sleep(RETRY_BACKOFF * attempt)
                    continue
                raise RuntimeError(str(data["error"])[:300])
            choice = data["choices"][0]
            answer = (choice["message"].get("content") or "").strip()
            finish = choice.get("finish_reason")
            # An empty body with finish_reason "length" is not transient. The
            # model spent its whole budget on `reasoning` and never reached the
            # answer, and it will do exactly that again -- measured on live
            # captures from two vendors, both emitting zero content after 60
            # tokens. Retrying is `retries` more billed calls, every one of them
            # certain to fail, and it buries the real fix.
            if not answer and finish == "length":
                raise RuntimeError(
                    "no answer — the whole token budget went to reasoning; "
                    "raise max_tokens for this lane"
                )
            # An empty body otherwise IS worth another attempt: free endpoints
            # return it under load (measured: 1 call in 6 on one provider, 1
            # completion token, finish_reason "stop"). The dead call billed its
            # prompt only, so a retry is far cheaper than losing the lane. It IS
            # a second charge on a metered lane, so it stays bounded by `retries`
            # exactly like every other path here.
            if not answer and attempt < retries:
                attempt += 1
                time.sleep(RETRY_BACKOFF * attempt)
                continue
            return {
                "answer": answer,
                "finish_reason": finish,
                "served_by": data.get("provider"),
                "usage": data.get("usage"),
            }
        except urllib.error.HTTPError as e:
            retry_after = e.headers.get("Retry-After") if e.headers else None
            transient = e.code >= 500 or e.code == 429
            if transient and attempt < retries:
                attempt += 1
                # Honour Retry-After rather than hammering a rate-limited vendor.
                wait = parse_retry_after(retry_after)
                time.sleep(min(wait, RETRY_AFTER_CAP) if wait is not None
                           else RETRY_BACKOFF * attempt)
                continue
            raise RuntimeError(f"HTTP {e.code}: {e.read()[:200].decode(errors='replace')}") from None
        except urllib.error.URLError as e:
            if attempt < retries:
                attempt += 1
                time.sleep(RETRY_BACKOFF * attempt)
                continue
            raise RuntimeError(f"connection failed: {e.reason}") from None
        except TimeoutError:
            # Deliberately NOT retried. The request may well have completed and
            # billed on the vendor side; a blind retry double-charges a metered
            # lane to produce an answer we already paid for.
            raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s") from None


def cli_lane(lane: dict, prompt: str) -> dict:
    """Run a subscription-backed CLI in one-shot mode.

    Two things here are not decoration:

    1. The child gets a scrubbed environment (see SCRUB_ENV) so an API key in the
       ambient shell cannot silently convert this free lane into a billed one.
    2. start_new_session=True puts the child in its own process group so a
       timeout can kill the whole tree. A plain subprocess timeout leaves a hung
       CLI (or one sitting at a login prompt) orphaned and running -- which is
       precisely the failure this tool was built to eliminate.
    """
    env = child_env(lane)

    cmd, stdin_text = [], None
    for arg in lane["args"]:
        if arg == "{prompt}":
            cmd.append(prompt)
        elif arg == "{personality}":
            cmd.append(lane.get("personality", ""))
        else:
            cmd.append(arg)
    if lane.get("stdin"):
        stdin_text = prompt
        cmd = [a for a in cmd if a != prompt]
    if lane.get("personality") and not any("{personality}" in a for a in lane["args"]):
        text = f"{lane['personality']}\n\n---\n\n{prompt}"
        if stdin_text is not None:
            stdin_text = text
        else:
            cmd = [lane["personality"] + "\n\n---\n\n" + a if a == prompt else a for a in cmd]

    proc = subprocess.Popen(
        [lane["command"], *cmd],
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(stdin_text, timeout=lane.get("timeout", 300))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        proc.wait(timeout=10)
        raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s (process group killed)") from None

    if proc.returncode != 0:
        raise RuntimeError(f"{lane['command']} exit {proc.returncode}: {err.strip()[:200]}")
    # Shell profiles and CLI update banners pollute stdout. Drop obvious
    # non-answer noise rather than trusting the stream to be clean.
    lines = [l for l in out.splitlines() if not l.strip().startswith(("🕐", "\x1b"))]
    text = "\n".join(lines).strip()
    if not text:
        raise RuntimeError("produced no output")
    return {"answer": text, "finish_reason": "stop", "served_by": lane["command"], "usage": None}


