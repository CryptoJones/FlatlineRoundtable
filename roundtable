# pricing
# --------------------------------------------------------------------------- #
def load_pricing(lanes: list[dict]) -> dict[str, tuple[float, float]]:
    """Per-token (prompt, completion) prices, keyed by model id.

    Hand-maintained prices in config go stale silently the moment a vendor
    changes them, and a stale number is worse than none because it reads as
    authoritative. Pull the real table instead, cached for a day so a run does
    not depend on the network.

    Config `price_per_mtok` still wins if set — it is the escape hatch for
    vendors with no price endpoint.
    """
    if not any(l.get("vendor") == "openrouter" for l in lanes):
        return {}
    try:
        if PRICING_CACHE.exists() and time.time() - PRICING_CACHE.stat().st_mtime < PRICING_TTL:
            raw = json.loads(PRICING_CACHE.read_text())
        else:
            with urllib.request.urlopen(OPENROUTER_MODELS, timeout=20) as r:
                raw = json.load(r)
            PRICING_CACHE.parent.mkdir(parents=True, exist_ok=True)
            PRICING_CACHE.write_text(json.dumps(raw))
    except Exception:
        # Never fail a run over pricing. Estimates degrade to config values.
        return {}
    out = {}
    for m in raw.get("data", []):
        pr = m.get("pricing") or {}
        try:
            out[m["id"]] = (float(pr.get("prompt", 0)), float(pr.get("completion", 0)))
        except (TypeError, ValueError):
            continue
    return out


def load_calibration() -> dict:
    """Observed chars-per-token per model, accumulated across past runs."""
    try:
        return json.loads(TOKENIZER_CACHE.read_text())
    except Exception:
        # A missing or corrupt cache must never fail a run: the constant is a
        # perfectly serviceable fallback, it is just wider than it needs to be.
        return {}


def chars_per_token(model: str | None, calib: dict) -> float:
    """Measured ratio for this model, or the pessimistic constant."""
    rec = calib.get(model or "")
    if not rec or rec.get("samples", 0) < MIN_CALIBRATION_SAMPLES:
        return CHARS_PER_TOKEN
    tokens = rec.get("tokens", 0)
    if tokens <= 0:
        return CHARS_PER_TOKEN
    # Shrink toward more-tokens-per-char so the estimate stays on the safe side.
    return max(1.0, (rec["chars"] / tokens) * CALIBRATION_SAFETY)


def record_calibration(results: list[dict], prompt: str, lanes: list[dict]) -> None:
    """Fold this run's real prompt_tokens back into the cache.

    Only http lanes report usage, and only the prompt side is measurable this
    way -- the completion side is already bounded by max_tokens, which is the
    worst case the budget check needs anyway.
    """
    by_name = {l["name"]: l for l in lanes}
    calib = load_calibration()
    touched = False
    for r in results:
        usage = r.get("usage") or {}
        ptok = usage.get("prompt_tokens")
        model = r.get("model")
        lane = by_name.get(r.get("lane"))
        if not (ptok and model and lane):
            continue
        chars = len(prompt) + len(lane.get("personality") or "")
        if chars <= 0:
            continue
        rec = calib.setdefault(model, {"chars": 0, "tokens": 0, "samples": 0})
        rec["chars"] += chars
        rec["tokens"] += int(ptok)
        rec["samples"] += 1
        touched = True
    if not touched:
        return
    try:
        TOKENIZER_CACHE.parent.mkdir(parents=True, exist_ok=True)
        TOKENIZER_CACHE.write_text(json.dumps(calib, indent=2, sort_keys=True))
    except OSError:
        pass      # a cache we cannot write is a slightly wider estimate, nothing more


def lane_prices(lane: dict, table: dict) -> tuple[float, float]:
    """(prompt, completion) per-token price for a lane, or (0, 0) if free/unknown."""
    if lane.get("price_per_mtok") is not None:      # explicit override
        p = float(lane["price_per_mtok"]) / 1_000_000
        return (p, p)
    if lane["harness"] in ("cli", "acp"):           # subscription — no marginal cost
        return (0.0, 0.0)
    return table.get(lane.get("model"), (0.0, 0.0))


def lane_price_known(lane: dict, table: dict) -> bool:
    """Whether lane_prices' (0, 0) would mean "free" rather than "no idea" (#72).

    lane_prices collapses both to zero, which is fine for reporting but is
    fail-open for the budget gate: an http lane whose model id is missing from
    the table -- every direct Mistral/DeepSeek/local endpoint, or a typo --
    estimated to $0.00 and so could never trip --max-spend. Free has three
    legitimate shapes; anything else on a metered harness is unknown.
    """
    if lane.get("price_per_mtok") is not None:      # explicit, including 0
        return True
    if lane["harness"] in ("cli", "acp"):           # subscription
        return True
    model = str(lane.get("model") or "")
    return model.endswith(":free") or model in table


def estimate_run(lanes: list[dict], prompt: str, table: dict, defaults: dict,
                 calib: dict | None = None, retries: int = 0) -> float:
    """Worst-case cost BEFORE dispatch (issue #4).

    Enforcing a budget only after responses return reports an overrun rather
    than preventing one -- the money is already spent by then. Assume every lane
    answers to its full max_tokens, which is the ceiling a run can actually hit.

    The prompt is charged (1 + retries) times, because http_lane re-issues on a
    200-carrying-an-error and on an empty answer, and both bill the prompt. This
    was previously ignored entirely: with the shipped default of retries: 3 the
    estimate could understate that term by 300%, while CALIBRATION_SAFETY shaved
    a further 10% off it in the name of staying conservative.

    Only the prompt side multiplies. A retry happens precisely when no usable
    completion came back, so the completion ceiling is still one max_tokens.
    """
    calib = calib or {}
    attempts = 1 + max(0, int(retries))
    total = 0.0
    for l in lanes:
        pin, pout = lane_prices(l, table)
        if not (pin or pout):
            continue
        in_tok = (len(prompt) + len(l.get("personality") or "")) / chars_per_token(
            l.get("model"), calib)
        out_tok = float(l.get("max_tokens", defaults.get("max_tokens", 2000)))
        total += in_tok * pin * attempts + out_tok * pout
    return total


# --------------------------------------------------------------------------- #
# config
# --------------------------------------------------------------------------- #
def load_config(path: Path) -> dict:
    if not path.exists():
        die(
            f"no config at {path}\n"
            f"  copy FlatlineRoundtable.yaml.example there and edit it, "
            f"or pass --config PATH"
        )
    try:
        cfg = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as e:
        die(f"{path} is not valid YAML: {e}")
    return validate_config(cfg, str(path))


def validate_config(cfg: dict, where: str) -> dict:
    """Validate a roster dict and apply `defaults` to each lane.

    Kept apart from the YAML read so a roster from any source -- a file today,
    the store next (#105) -- passes through exactly one set of rules. `where`
    names the source in error messages.
    """
    if not isinstance(cfg, dict):
        die(f"{where} is not a mapping")
    if not isinstance(cfg.get("lanes"), list) or not cfg["lanes"]:
        die(f"{where} defines no lanes")

    defaults = cfg.get("defaults") or {}
    seen: set[str] = set()
    lanes = []
    for i, raw in enumerate(cfg["lanes"]):
        if not isinstance(raw, dict):
            die(f"lane #{i + 1} is not a mapping")
        lane = {**defaults, **raw}
        name = lane.get("name")
        # YAML 1.1 reads Off/No as False and Yes/On as True, so an unquoted
        # lane called `Off` arrives here as a boolean and the truthiness check
        # below reported "has no name" -- an error naming neither the cause nor
        # the fix, for a plausible name for a parked lane.
        if name is not None and not isinstance(name, str):
            # The original text is already gone -- the parser handed us a bool --
            # so name the rule rather than echoing a useless {name!r}.
            die(f"lane #{i + 1}: name must be a string, got the boolean {name!r}. "
                f"YAML reads Off/No as false and Yes/On as true; "
                f"quote the name to keep it a string.")
        if not name:
            die(f"lane #{i + 1} has no name")
        if name in seen:
            die(f"duplicate lane name {name!r} — names must be unique")
        seen.add(name)

        harness = lane.get("harness")
        if harness not in ("http", "cli", "acp"):
            die(f"{name}: harness must be 'http', 'cli' or 'acp', got {harness!r}")
        if harness == "http":
            for req in ("model", "base_url"):
                if not lane.get(req):
                    die(f"{name}: http lane needs {req}")
        elif harness == "acp":
            if not lane.get("command"):
                die(f"{name}: acp lane needs a command")
        else:
            if not lane.get("command"):
                die(f"{name}: cli lane needs a command")
            if not lane.get("args"):
                die(f"{name}: cli lane needs args (use '{{prompt}}' or stdin: true)")
            # The line above only proved args is non-empty. Without one of these
            # two, the brief is never delivered: cmd carries no prompt, stdin is
            # DEVNULL, and the personality-prepend finds nothing to attach to.
            # The dangerous outcome is not the CLI erroring -- that fails loudly.
            # It is a CLI that answers an empty prompt with something plausible,
            # producing a lane that counts as a vote without having seen the
            # question.
            if "{prompt}" not in lane["args"] and not lane.get("stdin"):
                die(f"{name}: cli lane would send no prompt — "
                    f"put '{{prompt}}' in args, or set stdin: true")

        if lane.get("lineage") is not None and not isinstance(lane["lineage"], str):
            die(f"{name}: lineage must be a string naming a model family")

        if lane.get("rpm") is not None:
            try:
                rpm = float(lane["rpm"])
            except (TypeError, ValueError):
                die(f"{name}: rpm must be a number, got {lane['rpm']!r}")
            if rpm <= 0:
                die(f"{name}: rpm must be greater than 0 (omit it for no pacing)")

        bad = EXTRA_BODY_DENY & set((lane.get("extra_body") or {}).keys())
        if bad:
            die(f"{name}: extra_body may not set {', '.join(sorted(bad))}")
        lanes.append(lane)
    cfg["lanes"] = lanes
    return cfg


# --------------------------------------------------------------------------- #
# secrets
# --------------------------------------------------------------------------- #
def fetch_keys(lanes: list[dict]) -> dict[str, str]:
    """Resolve every pass entry ONCE, before fan-out.

    Doing this inside the worker threads instead means N concurrent `pass show`
    calls hitting one gpg-agent. If the store is locked that either serialises
    behind a single pinentry or, in a non-tty context, storms and fails. Resolve
    up front, deduped, while we are still single-threaded and can report one
    clear error instead of N identical ones.
    """
    entries = {l["key_entry"] for l in lanes if l.get("key_entry")}
    if not entries:
        return {}
    if not shutil.which("pass"):
        die(
            "lanes reference pass entries but `pass` is not installed.\n"
            "  install it, or remove key_entry from those lanes"
        )
    keys: dict[str, str] = {}
    for entry in sorted(entries):
        try:
            p = subprocess.run(
                ["pass", "show", entry], capture_output=True, text=True, timeout=30
            )
        except subprocess.TimeoutExpired:
            die(f"`pass show {entry}` timed out — is gpg-agent waiting on a passphrase?")
        if p.returncode != 0:
            die(
                f"no pass entry {entry!r}\n"
                f"  create it with:  pass insert {entry}"
            )
        # pass returns the whole file; the secret is the first line. Taking the
        # blob would put trailing metadata into an Authorization header.
        first = p.stdout.splitlines()[0].strip() if p.stdout.strip() else ""
        if not first:
            die(f"pass entry {entry!r} is empty")
        keys[entry] = first
    return keys

