# revision round
# --------------------------------------------------------------------------- #

REVISE_PROMPT = """This is round {round} of a panel. In round {prev} you answered the brief
below in isolation. Now — and only now — the full panel's answers are in front
of you, anonymised as PANELIST letters. Yours is marked.

Open your reply with exactly one word on its own line: HOLD or REVISE.
Then give your full current answer. It REPLACES your round-{prev} answer, so it
must stand alone. If you REVISE, name the specific argument that moved you and
the panelist letter it came from. If you HOLD, engage the strongest point made
against your position instead of restating yourself.

Do not converge for politeness, and do not defer to the majority or to any
model you think you recognise in an answer's style. Move only for a reason you
can state.
{extra}
--- THE BRIEF ---
{brief}

--- ROUND {prev} ANSWERS ---
{answers}"""


# The verdict the lane was told to open with. Tolerates the same decoration
# models actually emit around SECTION_RE's headers: `HOLD`, `**REVISE**`,
# `## HOLD`, `> REVISE`. Searched only near the top so a lane *quoting* the
# instructions mid-answer is not misread as a verdict.
VERDICT_RE = re.compile(r"^[ \t>#*]*(?:\*\*)?(HOLD|REVISE|NEW)\b", re.MULTILINE)


def parse_verdict(answer: str | None) -> str | None:
    m = VERDICT_RE.search((answer or "")[:400])
    return m.group(1) if m else None


def load_transcripts(arg: str, flag: str = "--revise") -> tuple[list[Path], dict]:
    """Resolve --revise's (or --synthesize's) argument into one merged prior round.

    Accepts explicit paths (comma-separated), `latest`, and `latest:N`. The
    multi-file forms exist because `--each` — the recommended way to run a
    panel — writes ONE TRANSCRIPT PER LANE by design, so "the previous round"
    of a 12-lane run is 12 files, and `latest:12` is how you name them without
    listing them.

    Briefs must match across the files: mixing transcripts of different
    questions is only ever an accident (a `latest:N` that reached past the run
    boundary into someone else's transcripts), and the merge would silently
    hand every lane a packet half about the wrong question.
    """
    paths: list[Path] = []
    for spec in (s.strip() for s in arg.split(",")):
        if not spec:
            continue
        if spec == "latest" or spec.startswith("latest:"):
            # Parse N defensively (#76): a bare int() here was the one place
            # the tool leaked a raw traceback where every other bad input
            # die()s with a message naming the fix. Zero and negatives are
            # refused too — cands[-0:] would silently mean "all of them".
            n_str = spec.split(":", 1)[1] if ":" in spec else "1"
            if not n_str.isdecimal() or int(n_str) < 1:
                die(f"{flag} latest:N needs a positive integer (e.g. latest:12)")
            n = int(n_str)
            cands = sorted(TRANSCRIPT_DIR.glob("*.json"))
            if len(cands) < n:
                die(f"{flag} {spec}: only {len(cands)} transcript(s) in {TRANSCRIPT_DIR}")
            paths.extend(cands[-n:])
        else:
            paths.append(Path(spec).expanduser())
    # Dedupe, then chronological order: transcript names begin with a timestamp
    # (then lane/pid for uniqueness), so sorting by name is sorting by time. This
    # makes the later answer win below when the same lane appears twice.
    paths = sorted(set(paths), key=lambda p: p.name)
    if not paths:
        die(f"{flag}: no transcript named")

    briefs: set[str] = set()
    by_lane: dict[str, dict] = {}
    round_no = 1
    rounds_seen: set[int] = set()
    for p in paths:
        try:
            data = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError) as e:
            die(f"cannot read transcript {p}: {e}")
        if not isinstance(data, dict) or "brief" not in data or "results" not in data:
            die(f"{p} is not a roundtable transcript (needs brief + results)")
        briefs.add(data["brief"].strip())
        round_no = max(round_no, int(data.get("round") or 1))
        rounds_seen.add(int(data.get("round") or 1))
        for r in data["results"]:
            # A panel transcript written mid-run holds None for the lanes that
            # had not answered yet; r.get() on one was a raw traceback (#118).
            if not isinstance(r, dict):
                continue
            # An answer never loses to a later failure of the same lane.
            if r.get("answer") or r["lane"] not in by_lane:
                by_lane[r["lane"]] = r
    if len(briefs) > 1:
        die(f"{flag}: transcripts answer different briefs — refusing to mix them.\n"
            "  name the files explicitly, or use latest:N with N = that run's lane count")
    if len(rounds_seen) > 1:
        # Found in first live use: retrying one failed lane of a revision round
        # with latest:N swept in the siblings' round-2 transcripts. The brief
        # guard cannot catch that — a revision round records the SAME brief —
        # and the merge would hand the lane its peers' round-2 answers labelled
        # as the round it is trying to redo.
        die(f"{flag}: transcripts span rounds {{}} — refusing to mix them.\n"
            "  name the files of ONE round explicitly".format(sorted(rounds_seen)))

    merged = {"brief": briefs.pop(), "results": list(by_lane.values()), "round": round_no}
    if not any(r.get("answer") for r in merged["results"]):
        die(f"{flag}: no answers in the named transcript(s)")
    return paths, merged


def print_synthesis(synth: dict | None, synth_err: str | None) -> None:
    """Print a --diff synthesis: each reader's reading, then where the readers disagree."""
    if synth:
        for r in synth["readings"]:
            print(f"\n{'=' * 74}\nWHERE THEY DIVERGE  (read by {r['by']})\n{'=' * 74}")
            print(r["text"])
        # Two readers exist so the reading's own bias is visible. Where they
        # place the same lane differently, that is the synthesizer talking,
        # not the panel -- go read that lane's raw answer.
        if synth["conflicts"]:
            print(f"\n{'=' * 74}\nTHE READERS DISAGREE\n{'=' * 74}")
            for c in synth["conflicts"]:
                where = "  ".join(
                    f"{by}={'/'.join(sec) if sec else 'unmentioned'}"
                    for by, sec in c["placements"].items()
                )
                print(f"  {c['lane']:<18} {where}")
            print("\n  These are classification disputes between the readers, not\n"
                  "  findings. Read those lanes' raw answers in the transcript.")
        elif len(synth["readings"]) > 1:
            print(f"\n  Both readers classified every lane the same way.")
        for e in synth.get("errors") or []:
            print(f"\n  !! reader failed — {e}", file=sys.stderr)
        n = len(synth["readings"])
        print(f"\n  -- {n} lane{'s' if n != 1 else ''} reading the others, not a verdict."
              f" raw answers in the transcript.")
    else:
        print(f"\n  !! {synth_err}", file=sys.stderr)


def synthesize_run(a, cfg: dict, lanes: list[dict]) -> int:
    """--synthesize: run only the --diff readers over a FINISHED run (#118).

    `--each --diff` is refused (#74) because synthesis needs every answer in one
    process, and its refusal said to "synthesize the transcripts afterwards" --
    but nothing did. This is that step. The answers are locked: they are read
    from the transcripts, no lane is re-queried, and the run's independence is
    untouched, because the readers see the answers only after every lane has
    given one. The only requests are the readers' own, and they go through the
    same budget gate, pricing, semaphores and pacing as a --diff run.

    The result is written as its own transcript carrying the parent run's
    run_id, with `results` empty so nothing that merges transcripts counts an
    answer twice.
    """
    paths, prior = load_transcripts(a.synthesize, flag="--synthesize")
    answered = [r for r in prior["results"] if r.get("answer")]
    if len(answered) < 2:
        die("--synthesize: need at least 2 answers to compare")
    ids = set()
    for p in paths:
        try:
            ids.add(json.loads(p.read_text()).get("run_id"))
        except (OSError, ValueError):
            pass
    # Same run as the answers it reads, so a reader of runs (the UI) shows the
    # synthesis on that run. An explicit --run-id wins; a mixed set gets a new one.
    run_id = a.run_id or (ids.pop() if len(ids) == 1 and None not in ids else new_run_id())

    count = int(cfg.get("synthesizers", 2))
    readers = pick_synthesizers(lanes, cfg.get("synthesizer"), count)
    if not readers:
        die("--synthesize: no active lane is available to read")
    budget = a.max_spend if a.max_spend is not None else cfg.get("budget_usd")
    prices = load_pricing(readers)
    if budget is not None:
        unpriced = [l for l in readers if not lane_price_known(l, prices)]
        if unpriced:
            die("a budget is set but these readers have no known price, so it cannot bind:\n"
                + "".join(f"  {l['name']}  (model {l.get('model') or '-'})\n" for l in unpriced)
                + "  set price_per_mtok on the lane, or pick a reader with --lanes")
    # The answers are known, so the estimate is exact on the input side rather
    # than the max_tokens ceiling estimate_synthesis has to assume before a run.
    calib = load_calibration()
    defaults = cfg.get("defaults") or {}
    body_chars = sum(len(r["answer"]) + len(r["lane"]) + 40 for r in answered)
    prompt_chars = min(len(prior["brief"]), 4000) + body_chars + len(SYNTH_PROMPT)
    estimate = 0.0
    for r in readers:
        pin, pout = lane_prices(r, prices)
        in_tok = prompt_chars / chars_per_token(r.get("model"), calib)
        out_tok = max(float(r.get("max_tokens", defaults.get("max_tokens", 2000))), 1500)
        estimate += in_tok * pin + out_tok * pout
    if budget is not None and estimate > budget:
        die(f"estimated worst case ${estimate:.4f} exceeds budget ${budget:.2f} — refusing to dispatch\n"
            f"  raise --max-spend or pick cheaper readers with --lanes")

    keys = fetch_keys(readers)
    sems = build_semaphores(readers, int(cfg.get("concurrency", 8)))
    pacers = build_pacers(readers)
    lock, spent = threading.Lock(), [0.0]
    deadline = time.time() + cfg["deadline_seconds"] if cfg.get("deadline_seconds") else None
    synth, synth_err = synthesize(answered, prior["brief"], cfg, readers, keys, prices,
                                  count=count, sems=sems, lock=lock, spent=spent,
                                  deadline=deadline, pacers=pacers,
                                  retries=int(cfg.get("retries", 1)))

    path = None
    if not a.no_transcript:
        private_transcript_dir()
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        path = TRANSCRIPT_DIR / f"{stamp}-synthesis-{os.getpid()}.json"
        save_transcript({"run_id": run_id, "brief": prior["brief"], "results": [],
                         "synthesis": synth, "synthesis_error": synth_err,
                         "mode": "synthesis", "round": int(prior.get("round") or 1),
                         "parent": [str(p) for p in paths],
                         "cost": round(spent[0], 6)}, path)
    if a.json:
        print(json.dumps({"run_id": run_id, "synthesis": synth, "error": synth_err,
                          "cost": round(spent[0], 6)}, indent=2))
    else:
        print(f"SYNTHESIS of {len(answered)} answers from {len(paths)} transcript(s)")
        print_synthesis(synth, synth_err)
        if path:
            print(f"transcript: {path}")
    return 0 if synth else 1


def private_transcript_dir() -> Path:
    """Make TRANSCRIPT_DIR exist and be private to the user (0700).

    A transcript holds the full brief and every lane's answer, and briefs are
    routinely confidential. The default umask leaves the directory
    world-listable, which hands the filenames -- and, with 0644 files, the
    contents -- to any local user, including a `cli` lane's vendor agent, which
    runs with full tool access (#73). The chmod on an existing dir is for
    transcript dirs created before this fix.
    """
    TRANSCRIPT_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    TRANSCRIPT_DIR.chmod(0o700)
    return TRANSCRIPT_DIR


def save_transcript(record: dict, path: Path) -> Path:
    """Write one transcript at `path`, private to the user (dir 0700, file 0600).

    Atomic via write-then-replace: a kill during the write leaves the previous
    good transcript rather than a truncated one (#58). The staging file is a
    UNIQUE mkstemp in the same directory (same filesystem, so the replace is
    still atomic): a name derived from `path` made two writers colliding on one
    transcript also collide on one .json.tmp and race before either rename (#70).
    The 0600 goes on the staging file BEFORE the replace, so there is no window
    in which the transcript is readable by anyone else (#73).
    """
    private_transcript_dir()
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), suffix=".json.tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(json.dumps(record, indent=2))
        os.replace(tmp, path)
    except BaseException:
        # Never leave a half-written temp behind if the write or rename fails.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return path


def alias_map(results: list[dict]) -> dict[str, str]:
    """Stable anonymous letters for every lane that answered.

    Anonymised because attribution invites authority-weighting — "the Anthropic
    lane said so" is exactly the deference the revision instructions forbid.
    One global map rather than per-viewer letters, so a lane writing "Panelist
    C's cost argument moved me" means the same C in every packet and in the
    transcript's audit record.
    """
    answered = [r["lane"] for r in results if r.get("answer")]
    return {name: (chr(ord("A") + i) if i < 26 else f"P{i + 1}")
            for i, name in enumerate(answered)}


def build_revision_prompt(lane_name: str, prior: dict, aliases: dict[str, str],
                          round_no: int, focus: str = "") -> str:
    own = next((r for r in prior["results"]
                if r["lane"] == lane_name and r.get("answer")), None)
    sections = []
    if own:
        sections.append(f"YOUR ROUND-{round_no - 1} ANSWER "
                        f"(you are PANELIST {aliases[lane_name]} to the others):\n"
                        f"{own['answer']}")
    else:
        sections.append(f"YOU GAVE NO ROUND-{round_no - 1} ANSWER (your lane failed or "
                        f"was absent). Treat this as your first answer, and open with "
                        f"the word NEW instead of HOLD or REVISE.")
    for r in prior["results"]:
        if not r.get("answer") or r["lane"] == lane_name:
            continue
        sections.append(f"PANELIST {aliases[r['lane']]}:\n{r['answer']}")
    extra = f"\n--- ADDITIONAL FOCUS FOR THIS ROUND ---\n{focus}\n" if focus else ""
    return REVISE_PROMPT.format(round=round_no, prev=round_no - 1,
                                brief=prior["brief"], extra=extra,
                                answers="\n\n".join(sections))


# --------------------------------------------------------------------------- #
# discussion mode
# --------------------------------------------------------------------------- #
# --discuss: the panel shares ONE context and takes turns in it, one lane in
# flight at a time.
#
# Buzz (the standing fleet) gives lanes a conversation by keeping a resident
# agent runtime per lane and a message bus between them, and that is exactly
# what made it too heavy to keep around. Here the "shared context space" is a
# string: the brief, the anonymised opening positions, and every turn said so
# far, in order. A turn is one ordinary ask() with that string as the prompt,
# so the process holds one request at a time -- a cli lane's agent runtime
# exists only for its turn -- and nothing outlives the run, which keeps the
# no-long-lived-process guarantee the rest of the tool is built on.
#
# The thread is O(N^2) in prompt tokens: turn k re-sends the k-1 turns before
# it. DISCUSS_WORDS caps what one turn adds and --discuss-rounds caps the
# passes; the budget gate prices the longest packet times the requests per lane.
#
# A shared thread has a failure mode a blind round cannot have: one lane's
# invention becomes everyone's premise. In the first live run (#98) a lane
# asserted a "default 24 h" expiry that does not exist and the next three
# turns cited it as evidence. Both prompts therefore say that a fact first
# introduced in the thread is a claim until its source is cited. That lowers
# the rate; the reader's verification pass is still the control.
#
# Every turn is appended to the transcript as soon as it returns, so a run that
# dies at turn 17 leaves 16 turns on disk. The closings are saved as `results`,
# which makes a discussion transcript a valid parent for --revise, --diff
# synthesis or another --discuss.
DISCUSS_WORDS = 300

DISCUSS_PROMPT = """This is a live panel discussion between {n} independent models. You are
PANELIST {me}. It is your turn: turn {turn} of {total}, pass {pas} of {passes}.

Everything below is shared context: the brief, each panelist's opening
position (written in isolation), and the discussion so far in the order it
was said. Every panelist sees exactly this.

Speak to the panel, not to a moderator. Address panelists by letter. Do at
least one of: concede a specific point that was right; challenge a specific
claim and say why; answer a question that was put to you; ask one question
whose answer would settle a dispute. Do not restate your opening and do not
summarise the discussion. Do not defer to the majority or to any model you
think you recognise. If nothing has been said yet, open the discussion with
the point you most want tested. Stay under {words} words.

A fact first introduced in this discussion -- not in the brief, not in an
opening -- is a claim, not evidence, until its source is cited: a file and
line, a command that was run, a document. Do not build on one; ask for its
source. If you rely on one anyway, say that you have not verified it.
{extra}
--- THE BRIEF ---
{brief}

--- OPENING POSITIONS ---
{openings}

--- DISCUSSION SO FAR ---
{thread}"""

CLOSING_PROMPT = """The discussion is over. You are PANELIST {me}. Give your closing position
on the brief.

Open your reply with exactly one word on its own line: HOLD or REVISE,
relative to your opening position (NEW if you gave none). Your closing
REPLACES your opening, so it must stand alone. If you REVISE, name the
argument that moved you and the panelist letter it came from. If you HOLD,
answer the strongest point made against you instead of restating yourself.
Move only for a reason you can state.

A fact first introduced in this discussion -- not in the brief, not in an
opening -- is a claim, not evidence, until its source is cited: a file and
line, a command that was run, a document. Do not let one carry your closing;
if it does, say that you have not verified it.
{extra}
--- THE BRIEF ---
{brief}

--- OPENING POSITIONS ---
{openings}

--- THE DISCUSSION ---
{thread}"""


def discussion_aliases(lanes: list[dict], prior: dict | None) -> dict[str, str]:
    """Letters for everyone in the room.

    Prior-round lanes keep the letters alias_map would give them, so a lane
    that opened as PANELIST C is still C when it speaks; roster lanes with no
    opening (a cold start, or a lane that failed in round 1) are lettered after.
    A prior lane not on this roster keeps its letter too -- its opening is
    still shown, it just never gets a turn.
    """
    aliases = alias_map(prior["results"]) if prior else {}
    for l in lanes:
        if l["name"] not in aliases:
            i = len(aliases)
            aliases[l["name"]] = chr(ord("A") + i) if i < 26 else f"P{i + 1}"
    return aliases


def render_openings(prior: dict | None, aliases: dict[str, str]) -> str:
    if not prior:
        return "(none -- this discussion starts cold)"
    return "\n\n".join(f"PANELIST {aliases[r['lane']]}:\n{r['answer']}"
                       for r in prior["results"] if r.get("answer"))


def render_thread(thread: list[dict]) -> str:
    # A turn that failed is kept in the transcript but not read to the panel:
    # "[no answer]" is noise to argue with. The turn numbers stay as spoken.
    said = [f"PANELIST {t['alias']} (turn {t['turn']}):\n{t['answer']}"
            for t in thread if t.get("answer")]
    return "\n\n".join(said) if said else "(nothing yet -- you speak first)"


def build_discussion_prompt(me: str, brief: str, prior: dict | None, aliases: dict[str, str],
                            thread: list[dict], turn: int, total: int, pas: int,
                            passes: int, n: int, focus: str = "") -> str:
    extra = f"\n--- ADDITIONAL FOCUS ---\n{focus}\n" if focus else ""
    return DISCUSS_PROMPT.format(n=n, me=me, turn=turn, total=total, pas=pas,
                                 passes=passes, words=DISCUSS_WORDS, extra=extra,
                                 brief=brief, openings=render_openings(prior, aliases),
                                 thread=render_thread(thread))


def build_closing_prompt(me: str, brief: str, prior: dict | None, aliases: dict[str, str],
                         thread: list[dict], focus: str = "") -> str:
    extra = f"\n--- ADDITIONAL FOCUS ---\n{focus}\n" if focus else ""
    return CLOSING_PROMPT.format(me=me, extra=extra, brief=brief,
                                 openings=render_openings(prior, aliases),
                                 thread=render_thread(thread))


def run_discussion(lanes: list[dict], brief: str, prior: dict | None,
                   aliases: dict[str, str], rounds: int, focus: str,
                   ask_one, on_turn, on_closing) -> tuple[list[dict], list[dict]]:
    """Drive the thread: `rounds` passes over the roster, then one closing each.

    Strictly sequential -- the next turn cannot be built until this one has
    been said, and one-at-a-time is the memory property the mode exists for.
    `ask_one(lane, packet)` is ask() with the run's plumbing applied; the two
    callbacks fire after every turn and every closing so the caller can stream
    and persist without this function knowing about terminals or transcripts.
    """
    n = len(lanes)
    total = rounds * n
    thread: list[dict] = []
    for pas in range(rounds):
        # Rotate the opener each pass so no lane always speaks first (anchoring
        # the pass) or last (getting the final word for free).
        order = lanes[pas % n:] + lanes[:pas % n]
        for l in order:
            turn = len(thread) + 1
            packet = build_discussion_prompt(aliases[l["name"]], brief, prior, aliases,
                                             thread, turn, total, pas + 1, rounds, n, focus)
            r = ask_one(l, packet)
            thread.append({"turn": turn, "pass": pas + 1, "alias": aliases[l["name"]], **r})
            on_turn(thread[-1], thread)
    closings: list = [None] * n
    for i, l in enumerate(lanes):
        closings[i] = ask_one(l, build_closing_prompt(aliases[l["name"]], brief, prior,
                                                      aliases, thread, focus))
        on_closing(closings)
    return thread, closings


def main() -> int:
    # Store commands (`db ...`, `secrets ...`) get their own parser. This must
    # run before argparse sees argv: the brief is free-text positional, so the
    # guard decides, narrowly, which argv is a command and which is a question.
    if is_admin_argv(sys.argv[1:]):
        return admin_main(sys.argv[1:])
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("brief", nargs="*")
    ap.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    ap.add_argument("--lanes")
    ap.add_argument("--each", action="store_true")
    ap.add_argument("-j", "--concurrency", type=int, default=None,
                    help="with --each, run up to N lanes at once (default 1). "
                         "Per-lane and per-vendor caps still apply.")
    ap.add_argument("--panel", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-spend", type=float)
    ap.add_argument("--no-transcript", action="store_true")
    ap.add_argument("--diff", action="store_true")
    ap.add_argument("--revise", metavar="TRANSCRIPT")
    # --converse is the same flag under the name CJ uses for it; argparse
    # binds both spellings to `discuss`, so nothing downstream knows which
    # one was typed.
    ap.add_argument("--discuss", "--converse", dest="discuss", metavar="TRANSCRIPT|new",
                    help="shared-context discussion, one lane speaking at a time: "
                         "seeded from a blind round's transcript(s), or `new` to "
                         "start cold from the brief")
    ap.add_argument("--discuss-rounds", type=int, default=2,
                    help="passes over the roster before closings (default 2)")
    ap.add_argument("--synthesize", metavar="TRANSCRIPT",
                    help="run only the --diff readers over a finished run's "
                         "transcripts (paths, latest, latest:N); no lane is re-asked")
    ap.add_argument("--run-id", metavar="ID",
                    help="tag every transcript of this run with ID (default: generated)")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip())
        return 0
    # One id for the whole run, forwarded to every --each child. Before this,
    # a fan-out left N transcripts with nothing tying them together, and a
    # reader (the UI, `--revise latest:N`) could only guess which belonged to
    # one run from timestamps (#116). Validated because it reaches a filename
    # reader and a URL in the UI: refuse anything but a plain token.
    if a.run_id is not None and not RUN_ID_RE.fullmatch(a.run_id):
        die("--run-id must be 1-64 characters of A-Z a-z 0-9 . _ - (not starting with .)")
    run_id = a.run_id or new_run_id()
    if a.synthesize and (a.each or a.panel or a.revise or a.discuss or a.diff):
        die("--synthesize reads a finished run; it does not start one.\n"
            "  Drop --each/--panel/--revise/--discuss/--diff.")
    if a.discuss:
        if a.revise:
            die("--discuss and --revise are two different second rounds; pick one")
        if a.each or a.panel:
            die("--discuss already runs the lanes one at a time, in one process:\n"
                "  each turn is built from the turns before it, so there is nothing\n"
                "  to fan out. Drop --each/--panel.")
        if a.discuss_rounds < 1:
            die("--discuss-rounds needs a positive integer")

    cfg = load_config(a.config)
    lanes = [l for l in cfg["lanes"] if l.get("active", True)]
    # `0/0 lanes answered` used to exit 0, reporting success for a run that
    # asked nobody anything. len(answered) == len(results) is true of two empty
    # lists. That is the same shape as partial delivery -- a lane that silently
    # did not run -- and in a cron or CI context the exit code is the only
    # signal anyone sees. --list is exempt: showing an empty roster is a fair
    # answer to "what is configured".
    if not lanes and not a.list:
        die(f"{a.config} has lanes, but none are active — "
            f"set active: true on at least one")
    if a.lanes:
        want = {n.strip().lower() for n in a.lanes.split(",")}
        lanes = [l for l in lanes if l["name"].lower() in want]
        if not lanes:
            die(f"--lanes matched nothing in {a.config}")

    if a.synthesize and not a.list:
        return synthesize_run(a, cfg, lanes)

    # Resolve `latest`/`latest:N` to concrete paths HERE, before --each fans
    # out. Children run sequentially and each writes a transcript, so a child
    # resolving "latest" for itself would pick up a sibling's round-2 output —
    # the exact self-echo this feature must not create.
    prior = None
    prior_paths: list[Path] = []
    if a.revise and not a.list:
        prior_paths, prior = load_transcripts(a.revise)
        a.revise = ",".join(str(p) for p in prior_paths)
    # A discussion seeded from a blind round keeps round 1's epistemic claim
    # intact; `new` starts cold, and its transcript is round 1 -- a dependent one.
    if a.discuss and a.discuss != "new" and not a.list:
        prior_paths, prior = load_transcripts(a.discuss)
    if a.discuss and len(lanes) < 2 and not a.list:
        die("--discuss needs at least two lanes; one lane is a monologue")

    # ONE RUN PER LANE.
    #
    # A single invocation finishes when its SLOWEST lane finishes, which couples
    # every lane's fate to the worst one: one slow lane sets the wall-clock for
    # all of them, raising its timeout pushes the run past a caller's timeout, and
    # a lane that dies cannot be retried without rerunning everything. Lanes are
    # meant to be independent; sharing a deadline makes their failures dependent.
    #
    # Measured 2026-08-30: the poolside/ACP lane needs ~400s alone on a 110KB
    # brief and exceeded 780s under 12-lane contention, losing its answer in four
    # consecutive rounds. Every one of those losses was avoidable.
    #
    # So multi-lane runs must say which they want. --each is the right answer and
    # is what the refusal points at; --panel is the escape hatch for anyone who
    # genuinely wants the old shared-deadline behaviour.
    # --discuss is exempt: it is sequential by construction (see run_discussion),
    # so no lane ever waits on another's deadline.
    if len(lanes) > 1 and not a.list and not (a.each or a.panel or a.discuss):
        die("refusing to run {n} lanes in one invocation.\n"
            "  A shared deadline makes independent lanes fail together: the run is\n"
            "  only as fast as its slowest lane, and one death costs every answer.\n"
            "\n"
            "  --each                run each lane as its own process (what you want)\n"
            "  --each -j N           the same, up to N lanes at once\n"
            "  --lanes NAME          one lane\n"
            "  --panel               the old shared-deadline behaviour, if you mean it"
            .format(n=len(lanes)))

    # #74: --diff used to evaporate under --each. The children's argv forwarded
    # --json/--no-transcript/--revise but not --diff, so the flag was accepted,
    # ignored, and the run exited 0 with no synthesis. Forwarding it would not
    # fix that: synthesis compares every lane's answer, and under --each each
    # answer lives in its own process -- a child with one lane has nothing to
    # compare. Refuse here, before any child is spawned and before any spend.
    if a.each and a.diff and not a.list:
        die("--each --diff: synthesis needs every answer in one process, and\n"
            "  --each gives each lane its own. Either:\n"
            "\n"
            "  --panel --diff        one shared deadline, then synthesis\n"
            "  --each, then --synthesize latest:N   readers over the finished run")

    if a.list:
        if a.json:
            # For tools (the UI's lane picker). Names the route, never a secret
            # or the `pass` entry holding one: a lane's key ref is config, not
            # something a caller of --list needs.
            print(json.dumps([{"name": l["name"], "harness": l["harness"],
                               "vendor": l.get("vendor"), "model": l.get("model"),
                               "route": safe_route(l.get("base_url")) or l.get("command") or ""}
                              for l in lanes], indent=2))
            return 0
        for l in lanes:
            route = l["harness"]
            where = l.get("base_url") or l.get("command") or ""
            print(f"  [{route:<4}] {l['name']:<18} {str(l.get('vendor') or '-'):<14} "
                  f"{str(l.get('model') or '-'):<42} {where}")
        print(f"\n  {len(lanes)} active lane(s). No calls made.")
        return 0

    prompt = sys.stdin.read() if a.brief[:1] == ["-"] else " ".join(a.brief)
    if not prompt.strip() and not a.revise and not prior:
        die("empty brief")

    # In a revision round the brief on record stays the ORIGINAL question; any
    # brief text passed alongside --revise rides in the packet as extra focus.
    prompts = aliases = None
    round_no = 1
    brief_on_record = prompt
    est_prompt = prompt
    if a.revise:
        aliases = alias_map(prior["results"])
        round_no = int(prior.get("round") or 1) + 1
        prompts = {l["name"]: build_revision_prompt(l["name"], prior, aliases,
                                                    round_no, focus=prompt.strip())
                   for l in lanes}
        brief_on_record = prior["brief"]
        # Packets differ per lane only by which answer is marked YOURS; the
        # longest one is the honest worst case for the budget gate.
        est_prompt = max(prompts.values(), key=len)
    focus = ""
    if a.discuss:
        aliases = discussion_aliases(lanes, prior)
        if prior:
            round_no = int(prior.get("round") or 1) + 1
            brief_on_record = prior["brief"]
            focus = prompt.strip()
        # The budget gate's worst case: the last closing packet, i.e. the full
        # context plus every turn at the word cap (~7 chars a word with the
        # PANELIST headers). Multiplied by requests-per-lane below.
        est_prompt = build_closing_prompt(
            "A", brief_on_record, prior, aliases,
            [{"turn": i + 1, "alias": "A", "answer": "x" * (DISCUSS_WORDS * 7)}
             for i in range(a.discuss_rounds * len(lanes))], focus)

    budget = a.max_spend if a.max_spend is not None else cfg.get("budget_usd")
    deadline = time.time() + cfg["deadline_seconds"] if cfg.get("deadline_seconds") else None
    prices = load_pricing(lanes)

    # A budget can only bind on lanes it can price. An unpriced http lane used
    # to estimate to $0 and slip past the gate unseen (#72) -- fail-open on the
    # one check whose job is to fail closed. No default rate either: a guessed
    # number reads as authoritative and is wrong for almost every vendor.
    if budget is not None:
        unpriced = [l for l in lanes if not lane_price_known(l, prices)]
        if unpriced:
            die(
                "a budget is set but these lanes have no known price, so it cannot bind:\n"
                + "".join(f"  {l['name']}  (model {l.get('model') or '-'})\n" for l in unpriced)
                + "  set price_per_mtok on the lane or add vendor: openrouter so the "
                "price table covers it"
            )

    # Refuse BEFORE spending, not after. A budget checked only on the way out
    # reports an overrun; it does not prevent one.
    #
    # This gate must also sit BEFORE the --each fan-out below (issue #71). It
    # used to sit after that branch returned, so the parent never ran it: each
    # child gated only its own lane, and a roster where no single lane is
    # expensive but the panel total is walked through N cheap gates and spent
    # N× what any one estimate implied. The whole-panel estimate is the one the
    # README promises, so it runs here over the full selected set; the child's
    # own gate stays as a backstop, not the only check.
    calib = load_calibration()
    defaults = cfg.get("defaults") or {}
    estimate = estimate_run(lanes, est_prompt, prices, defaults, calib,
                            retries=int(cfg.get("retries", 1)))
    if a.diff:
        # The readers are dispatched from inside this run, so their cost belongs
        # in the gate that decides whether to dispatch at all.
        estimate += estimate_synthesis(lanes, brief_on_record, prices, defaults, calib,
                                       cfg.get("synthesizer"),
                                       int(cfg.get("synthesizers", 2)))
    if a.discuss:
        # Each lane speaks once per pass and once to close.
        estimate *= a.discuss_rounds + 1
    if budget is not None and estimate > budget:
        die(
            f"estimated worst case ${estimate:.4f} exceeds budget ${budget:.2f} — refusing to dispatch\n"
            f"  raise --max-spend, drop lanes with --lanes, or lower max_tokens"
        )

    if a.each:
        # Re-invoke ourselves once per lane. Separate processes, separate
        # deadlines, separate transcripts: a lane can be slow, or die, alone.
        # The panel-wide budget gate above has already passed; a child re-runs
        # it for its single lane only as a backstop (issue #71).
        #
        # Serial by DEFAULT, still: the measurement in the block above is why,
        # and a config that predates this flag must not silently start fanning
        # out. `--concurrency N` is the opt-in, and it is the only way to get
        # parallel lanes without the shared deadline --panel imposes.
        #
        # Before this flag existed there was no such way: this loop was a
        # blocking subprocess.run, so --each was always serial, and anyone who
        # wanted lanes in parallel had to reach for --panel and give up the
        # per-lane deadlines that are the entire point of --each. The `concurrency:`
        # key in the config is deliberately NOT read here -- it is documented as
        # the panel-mode default, the shipped example sets it to 8, and quietly
        # honouring it would flip every existing caller from serial to eight-way.
        #
        # The per-vendor cap IS applied, by the same smallest-in-group rule
        # build_semaphores uses, so a `concurrency: 1` local lane still cannot be
        # run beside its neighbour on the same GPU while the API lanes fan out.
        #
        # Output stays in roster order: a lane's block is printed whole, once
        # every lane before it has been printed, so a concurrent run reads
        # exactly like a serial one instead of interleaving. At -j1 the child
        # keeps the terminal directly, so the familiar live streaming is intact.
        #
        # --diff is deliberately not forwarded: --each --diff was refused above
        # (#74), so it cannot reach this point.
        default_cc = max(int(a.concurrency or 1), 1)
        caps: dict[str, int] = {}
        for l in lanes:
            gid = l.get("vendor") or l["name"]
            cc = int(l.get("concurrency", default_cc))
            caps[gid] = min(caps.get(gid, cc), cc)
        vendor_sems = {gid: threading.Semaphore(cc) for gid, cc in caps.items()}
        overall = threading.Semaphore(max(default_cc, 1))

        def child_argv(l: dict) -> list[str]:
            argv = [sys.executable, str(Path(__file__).resolve()),
                    "--lanes", l["name"], "--config", str(a.config),
                    "--run-id", run_id]
            if a.json:
                argv.append("--json")
            if a.no_transcript:
                argv.append("--no-transcript")
            if a.revise:
                argv += ["--revise", a.revise]
            argv.append("-")
            return argv

        def run_one(l: dict) -> tuple[int, str]:
            gid = l.get("vendor") or l["name"]
            with overall, vendor_sems[gid]:
                r = subprocess.run(child_argv(l), input=prompt, text=True,
                                   capture_output=True)
            return r.returncode, (r.stdout or "") + (r.stderr or "")

        rc = 0
        if default_cc == 1:
            # Unchanged path: the child inherits this terminal and streams.
            for l in lanes:
                print(f"\n=== {l['name']} " + "=" * (66 - len(l['name'])), flush=True)
                r = subprocess.run(child_argv(l), input=prompt, text=True)
                rc = rc or r.returncode
            return rc

        with cf.ThreadPoolExecutor(max_workers=max(len(lanes), 1)) as pool:
            futures = [pool.submit(run_one, l) for l in lanes]
            for l, fut in zip(lanes, futures):
                print(f"\n=== {l['name']} " + "=" * (66 - len(l['name'])), flush=True)
                try:
                    code, out = fut.result()
                except Exception as exc:                      # noqa: BLE001
                    code, out = 1, f"  !! lane crashed: {exc}\n"
                sys.stdout.write(out)
                sys.stdout.flush()
                rc = rc or code
        return rc

    # Keys are resolved after the fan-out decision so the --each parent, which
    # never queries anything itself, does not hit `pass` once for every lane
    # its children are about to hit it for again.
    keys = fetch_keys(lanes)
    sems = build_semaphores(lanes, int(cfg.get("concurrency", 8)))
    # Concurrency bounds how many are in flight; rpm bounds how fast they start.
    pacers = build_pacers(lanes)

    lock, spent = threading.Lock(), [0.0]
    t0 = time.time()

    # The transcript path is claimed BEFORE the fan-out, not after it, so that a
    # run which dies mid-flight still leaves its finished lanes on disk. This
    # used to be `list(pool.map(...))` followed by a single write at the end:
    # every completed answer was held in memory until the last lane returned, so
    # a SIGKILL, a closed terminal, a harness timeout or a Ctrl-C anywhere in the
    # fan-out threw away every answer already collected -- including paid http
    # lanes that had billed for tokens nobody would ever read. The symptom is a
    # run that "randomly dies" with zero output and no transcript.
    path = None
    if not a.no_transcript:
        private_transcript_dir()
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        # One lane per process (the --each contract), so the lane name makes the
        # path unique across a fan-out. The second-resolution timestamp alone was
        # NOT unique: `--each -j N` starts lanes within the same second, and every
        # child computed its own stamp independently — so they collided on one path
        # and overwrote each other's answers while exiting 0 (#70). pid covers two
        # runs of the SAME lane in the same second (a retry, or a bare single-lane
        # call), which is otherwise still possible.
        suffix = f"-{lanes[0]['name']}" if len(lanes) == 1 else ""
        if a.discuss:
            suffix = "-discuss"
        path = TRANSCRIPT_DIR / f"{stamp}{suffix}-{os.getpid()}.json"

    thread: list[dict] = []

    def save(results_so_far, synthesis=None, collisions=None, partial=True):
        """Write the transcript. Called after every lane, and again at the end.

        Atomic via write-then-replace: a kill during the write leaves the previous
        good transcript rather than a truncated one.
        """
        if path is None:
            return
        # brief_on_record stays the ORIGINAL question in a revision round; in a
        # first round it is just `prompt`. A revision transcript also records the
        # round number, its parents, and the alias map, exactly as a completed
        # round does -- so a partial revision transcript reads like a full one.
        payload = {"run_id": run_id, "brief": brief_on_record, "results": results_so_far,
                   "synthesis": synthesis, "collisions": collisions}
        if prompts or a.discuss:
            payload.update({"round": round_no,
                            "parent": [str(p) for p in prior_paths],
                            "aliases": aliases})
        if a.discuss:
            # The thread is the product; `results` (the closings) is what makes
            # this file a round another mode can build on.
            payload.update({"mode": "discuss", "discuss_rounds": a.discuss_rounds,
                            "discussion": thread})
        if partial:
            payload["partial"] = True
            payload["note"] = ("run did not finish — these are the lanes that had "
                               "answered when the transcript was last written")
        # Staged to a unique temp, chmod 0600, then replaced: see save_transcript.
        save_transcript(payload, path)

    ordered = [None] * len(lanes)
    if a.discuss:
        retries = int(cfg.get("retries", 1))

        def ask_one(l: dict, packet: str) -> dict:
            # deadline_seconds bounds ONE turn here, not the run: a discussion
            # is rounds * lanes dependent requests, and a whole-run clock sized
            # for a single fan-out would cut every discussion off mid-thread.
            turn_deadline = (time.time() + cfg["deadline_seconds"]
                             if cfg.get("deadline_seconds") else None)
            return ask(l, packet, keys, retries, turn_deadline, sems, lock, spent,
                       lane_prices(l, prices), pacers)

        def on_turn(t: dict, so_far: list[dict]) -> None:
            thread[:] = so_far
            save(ordered)
            if a.json:
                return
            print(f"\n--- pass {t['pass']} · turn {t['turn']}/{a.discuss_rounds * len(lanes)}"
                  f" · {t['lane']} (PANELIST {t['alias']}) · {t['seconds']}s")
            print(t["answer"] if t["answer"] else f"  !! {t['error']}", flush=True)

        def on_closing(closings: list) -> None:
            for i, c in enumerate(closings):
                ordered[i] = c
            save(ordered)

        if not a.json:
            print(f"DISCUSSION — {len(lanes)} lanes, {a.discuss_rounds} pass(es), one at a time",
                  flush=True)
        run_discussion(lanes, brief_on_record, prior, aliases, a.discuss_rounds,
                       focus, ask_one, on_turn, on_closing)
        results = ordered
    else:
        with cf.ThreadPoolExecutor(max_workers=max(len(lanes), 1)) as pool:
            # In a revision round each lane gets its own packet (prompts[name]);
            # otherwise every lane gets the same brief.
            futures = {
                pool.submit(ask, l, prompts[l["name"]] if prompts else prompt,
                            keys, int(cfg.get("retries", 1)), deadline,
                            sems, lock, spent, lane_prices(l, prices), pacers): i
                for i, l in enumerate(lanes)
            }
            for fut in cf.as_completed(futures):
                i = futures[fut]
                try:
                    ordered[i] = fut.result()
                except Exception as e:  # noqa: BLE001 — mirror ask()'s own contract
                    ordered[i] = {"lane": lanes[i]["name"], "model": lanes[i].get("model"),
                                  "vendor": lanes[i].get("vendor"), "harness": lanes[i]["harness"],
                                  "answer": None, "error": str(e), "finish_reason": None}
                # Persist after every lane. Order is preserved by writing into the
                # slot the lane was dispatched from, so a partial transcript reads
                # the same way a complete one does, with `null` for lanes still out.
                save(ordered)

    results = ordered

    answered = [r for r in results if r["answer"]]

    # Fold this run's real prompt_tokens back in, so the next pre-flight
    # estimate is measured rather than assumed.
    # Calibration pairs one prompt length with each lane's measured
    # prompt_tokens; in a revision round every lane got a different packet, so
    # feeding any single length would poison the ratio for the next estimate.
    if not prompts and not a.discuss:
        record_calibration(results, prompt, lanes)

    # Convergence between lanes that turn out to be the same model is an echo,
    # not evidence. Never fatal -- a deliberate duplicate is a legitimate thing
    # to want -- but it must not be silent, because it is invisible in the
    # answers themselves.
    collisions = lineage_collisions(results, lanes)

    synth = None
    if a.diff:
        synth, synth_err = synthesize(results, brief_on_record, cfg, lanes, keys, prices,
                                      count=int(cfg.get("synthesizers", 2)),
                                      sems=sems, lock=lock, spent=spent,
                                      deadline=deadline, pacers=pacers,
                                      retries=int(cfg.get("retries", 1)))

    # Final write: same file the fan-out has been updating, now complete and with
    # the synthesis attached. Clears the `partial` marker. Revision metadata
    # (round/parent/aliases) is folded in by save() when this is a revision round.
    save(results, synthesis=synth, collisions=collisions, partial=False)

    if a.json:
        if a.discuss:
            out = {"discussion": thread, "results": results}
            if a.diff:
                out["synthesis"] = synth
        else:
            out = {"results": results, "synthesis": synth} if a.diff else results
        print(json.dumps(out, indent=2))
    elif a.diff:
        print_synthesis(synth, synth_err)
    else:
        if a.discuss:
            print(f"\n{'=' * 74}\nCLOSINGS — each lane's position after the discussion")
        for r in results:
            # served_by was captured on every http response and never shown.
            # Who actually answered is the evidence for the independence claim.
            via = f"  via {r['served_by']}" if r.get("served_by") else ""
            print(f"\n{'=' * 74}\n{r['lane']}  ({r['model'] or r['harness']})"
                  f"{via}  {r['seconds']}s")
            print("=" * 74)
            print(r["answer"] if r["answer"] else f"  !! {r['error']}")
            if r.get("truncated"):
                print("\n  !! TRUNCATED — salvaged at the lane timeout; the turn never finished"
                      if r.get("finish_reason") == "timeout" else
                      "\n  !! TRUNCATED — hit max_tokens; raise it for this lane")
        if prompts or a.discuss:
            moves = [(r["lane"], parse_verdict(r["answer"]) or "?")
                     for r in results if r["answer"]]
            held = sum(1 for _, v in moves if v == "HOLD")
            unparsed = sum(1 for _, v in moves if v == "?")
            print(f"\n{'=' * 74}")
            if a.discuss:
                spoke = sum(1 for t in thread if t.get("answer"))
                print(f"ROUND {round_no} — closings after a shared discussion"
                      f" ({spoke}/{len(thread)} turns spoken, {a.discuss_rounds} pass(es))."
                      f" Agreement here is persuasion, not independent convergence.")
            else:
                print(f"ROUND {round_no} — lanes saw the round-{round_no - 1} answers."
                      f" Agreement here is persuasion, not independent convergence.")
            # A closing with no verdict word is not a move; say so rather than
            # folding it into the moved count.
            tail = f", {unparsed} gave no verdict" if unparsed else ""
            print(f"  {held} HOLD, {len(moves) - held - unparsed} moved{tail}:")
            for lane, v in moves:
                print(f"    {lane:<18} {v}")
        print(f"\n{'=' * 74}")
        print(f"{len(answered)}/{len(results)} lanes answered in {time.time() - t0:.1f}s")
        if spent[0] or estimate:
            print(f"spend: ${spent[0]:.4f} actual  (est. worst case ${estimate:.4f})")
        if not a.no_transcript:
            print(f"transcript: {path}")
        for r in results:
            if not r["answer"]:
                print(f"  FAILED  {r['lane']}: {r['error']}")
        # Next to the summary rather than above the answers: a warning printed
        # before the reader has seen anything is a warning they scroll past.
        if collisions:
            print(f"\n  LANES THAT ARE NOT INDEPENDENT", file=sys.stderr)
            for c in collisions:
                how = "declared lineage" if c["kind"] == "lineage" else "answered from"
                print(f"    {', '.join(c['lanes'])} — {how} {c['detail']}",
                      file=sys.stderr)
            print("    Agreement between these is an echo, not convergence.",
                  file=sys.stderr)

    # Backstop only -- the pre-flight gate above is what actually protects the
    # budget. This catches an estimate that was too optimistic.
    if budget is not None and spent[0] > budget:
        print(f"\n!! spend ${spent[0]:.4f} exceeded budget ${budget:.2f}", file=sys.stderr)
        return 2
    # A silent lane is the bug this tool exists to eliminate, so partial
    # delivery is a failure, not a pass.
    return 0 if len(answered) == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
