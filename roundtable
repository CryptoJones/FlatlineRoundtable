def acp_lane(lane: dict, prompt: str) -> dict:
    """Drive an ACP (Agent Client Protocol) agent for exactly one turn.

    Some assistants expose no one-shot print mode -- only JSON-RPC over stdio.
    This does the minimum exchange to get one answer:

        initialize -> session/new -> session/prompt -> collect updates -> kill

    The process is created for this turn and killed at the end of it, in its own
    process group. That is the whole point: an ACP agent is a SERVER and will sit
    there indefinitely if you let it, which is precisely the long-lived-process
    failure this tool exists to avoid. Do not "optimise" this by reusing a
    session across lanes or keeping the process warm.
    """
    env = child_env(lane)
    proc = subprocess.Popen(
        [lane["command"], *(lane.get("args") or [])],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, bufsize=1, env=env, start_new_session=True,
    )
    lk, replies, chunks = threading.Lock(), {}, []

    def reader():
        try:
            for line in proc.stdout:
                try:
                    m = json.loads(line)
                except (ValueError, TypeError):
                    continue          # agents emit non-JSON banners on stdout
                if "id" in m and ("result" in m or "error" in m):
                    with lk:
                        replies[m["id"]] = m
                elif m.get("method") == "session/update":
                    u = (m.get("params") or {}).get("update") or {}
                    if u.get("sessionUpdate") == "agent_message_chunk":
                        t = (u.get("content") or {}).get("text")
                        if t:
                            chunks.append(t)
        except (ValueError, OSError):
            pass                       # stream closed under us on kill

    threading.Thread(target=reader, daemon=True).start()
    deadline = time.time() + lane.get("timeout", 300)

    def call(rid, method, params):
        proc.stdin.write(json.dumps(
            {"jsonrpc": "2.0", "id": rid, "method": method, "params": params}) + "\n")
        proc.stdin.flush()
        while time.time() < deadline:
            with lk:
                if rid in replies:
                    return replies[rid]
            if proc.poll() is not None:
                raise RuntimeError(f"{lane['command']} exited during {method}")
            time.sleep(0.05)
        raise RuntimeError(f"timed out waiting for {method}")

    try:
        call(0, "initialize", {"protocolVersion": lane.get("protocol_version", 1),
                               "clientCapabilities": {"fs": {"readTextFile": False,
                                                             "writeTextFile": False}}})
        r = call(1, "session/new", {"cwd": os.getcwd(), "mcpServers": []})
        sid = (r.get("result") or {}).get("sessionId")
        if not sid:
            raise RuntimeError(f"session/new returned no sessionId: {str(r)[:150]}")
        text = prompt
        if lane.get("personality"):
            text = f"{lane['personality']}\n\n---\n\n{prompt}"
        r = call(2, "session/prompt",
                 {"sessionId": sid, "prompt": [{"type": "text", "text": text}]})
        if "error" in r:
            raise RuntimeError(str(r["error"])[:200])
        stop = (r.get("result") or {}).get("stopReason")
        answer = "".join(chunks).strip()
        if not answer:
            raise RuntimeError(f"no agent_message_chunk received (stopReason={stop})")
        return {"answer": answer,
                "finish_reason": "length" if stop == "max_tokens" else "stop",
                "served_by": lane["command"], "usage": None}
    finally:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            pass


def ask(lane, prompt, keys, retries, deadline, sems, lock, spent, prices, pacers=None):
    started = time.time()
    result = {
        "lane": lane["name"],
        "model": lane.get("model"),
        "vendor": lane.get("vendor"),
        "harness": lane["harness"],
        "answer": None,
        "error": None,
        "finish_reason": None,
    }
    # A vendor with no configured semaphore must not crash the lane -- ask() is
    # called from synthesize() as well as the fan-out, and a reader's vendor may
    # not be in `sems`. This was a nullcontext until the deadline work replaced
    # `with sem:` by an explicit acquire/release, which nullcontext does not
    # have. None is the honest value, and every use below already guards for it.
    sem = sems.get(lane.get("vendor") or lane["name"])
    try:
        if deadline and time.time() > deadline:
            raise RuntimeError("global deadline passed before dispatch")
        pacer = (pacers or {}).get(lane.get("vendor") or lane["name"])
        if pacer:
            result["paced_s"] = round(pacer.wait(), 2)
            # Pacing can push a lane past a deadline that it was inside when the
            # run started. Re-check rather than dispatching a request whose
            # answer we have already decided not to wait for.
            if deadline and time.time() > deadline:
                raise RuntimeError("global deadline passed while pacing")
        # Waiting for a vendor slot is unbounded without this, and both checks
        # above have already passed by then -- which is how deadline_seconds
        # came to bound nothing at all. Every thread reached them at t=0.
        if sem is not None:
            slot_wait = (deadline - time.time()) if deadline else None
            if slot_wait is not None and slot_wait <= 0:
                raise RuntimeError("global deadline passed before dispatch")
            if not (sem.acquire(timeout=slot_wait) if slot_wait is not None
                    else sem.acquire()):
                raise RuntimeError("global deadline passed waiting for a vendor slot")
        try:
            # The lane's own timeout, further capped by whatever is left of the
            # run. "whole-run wall clock" has to actually bound the wall clock,
            # or it reads as a guarantee it does not give.
            budget_s = lane.get("timeout", 300)
            if deadline:
                budget_s = min(budget_s, deadline - time.time())
                if budget_s <= 0:
                    raise RuntimeError("global deadline passed before dispatch")
            bounded = {**lane, "timeout": budget_s}
            if lane["harness"] == "acp":
                out = acp_lane(bounded, prompt)
            elif lane["harness"] == "cli":
                out = cli_lane(bounded, prompt)
            else:
                key = keys.get(lane["key_entry"]) if lane.get("key_entry") else None
                out = http_lane(bounded, prompt, key, retries)
        finally:
            if sem is not None:
                sem.release()
        result.update(out)
        if not result["answer"]:
            result["error"] = "empty answer"
        # A clipped answer is a silent failure: it reads as complete and is not.
        if result.get("finish_reason") == "length":
            result["truncated"] = True
        # Charge prompt and completion separately: completion is typically 2-4x
        # the prompt rate, so a blended per-token figure understates a long answer.
        pin, pout = prices
        u = out.get("usage") or {}
        if (pin or pout) and u:
            cost = (u.get("prompt_tokens") or 0) * pin + (u.get("completion_tokens") or 0) * pout
            result["cost"] = round(cost, 6)
            with lock:
                spent[0] += cost
    except Exception as e:  # noqa: BLE001 — a lane failing must never kill the run
        result["error"] = str(e)
    result["seconds"] = round(time.time() - started, 1)
    return result


SYNTH_PROMPT = """Below are {n} independent answers to the same question, each from a
different model that could not see the others.

Report ONLY:
1. AGREED — points where they independently land in the same place.
2. SPLIT — points of genuine disagreement. For each, say WHO takes which side and
   WHY they differ (different assumption, different priority, different reading).
3. LONE CLAIMS — anything asserted by exactly one lane that the others neither
   support nor contradict. Flag any that look like invented specifics.

Do not summarise the answers. Do not add your own opinion on the question.
If they substantially agree, say so in one line rather than manufacturing a split.

--- THE QUESTION ---
{brief}

--- THE ANSWERS ---
{answers}"""


SYNTH_SECTIONS = ("AGREED", "SPLIT", "LONE CLAIMS")

# A section header, and only at the start of a line.
#
# Matching the bare word anywhere used to be enough to relocate every finding: a
# reader that opens with "I will report AGREED, SPLIT and LONE CLAIMS below"
# put all three markers in its preamble, so every lane fell into whichever
# section came last. Restating the instructions is the common case, not an
# exotic one, and the result was a THE READERS DISAGREE block listing lanes that
# both readers had in fact classified identically.
#
# Tolerates the shapes models actually emit: `AGREED`, `## AGREED`, `**AGREED**`,
# `1. AGREED`, `### 2) SPLIT`.
SECTION_RE = re.compile(
    r"^[ \t]{0,3}(?:#{1,6}[ \t]*)?(?:\*\*)?(?:\d+[.)][ \t]*)?(?:\*\*)?"
    r"(AGREED|SPLIT|LONE[ \t]+CLAIMS)\b",
    re.IGNORECASE | re.MULTILINE,
)


def pick_synthesizers(lanes, want, n):
    """Choose up to n readers, preferring free lanes from *different* vendors.

    Vendor spread is the point: two readings from one lineage share the priors
    that make a single reading untrustworthy, so they would agree for the same
    reason rather than independently.
    """
    named = [l for l in lanes if l["name"] == want] if want else []
    pool = [l for l in lanes if l["name"] != want]

    def rank(l):
        # cli and acp ride a subscription; :free costs nothing; the rest bill.
        # acp used to rank alongside metered http, which made reader choice
        # roster-order dependent and contradicted "prefers free lanes".
        # lane_prices already treats acp as free -- this now agrees with it.
        return (0 if l["harness"] in ("cli", "acp")
                else 1 if str(l.get("model", "")).endswith(":free")
                else 2)

    chosen, used_vendors = list(named), {l.get("vendor") for l in named}
    for lane in sorted(pool, key=rank):
        if len(chosen) >= n:
            break
        if lane.get("vendor") in used_vendors:
            continue
        chosen.append(lane)
        used_vendors.add(lane.get("vendor"))
    # Only if vendor spread could not fill the quota, allow a repeat vendor --
    # two readings still beat one, even correlated ones.
    for lane in sorted(pool, key=rank):
        if len(chosen) >= n:
            break
        if lane not in chosen:
            chosen.append(lane)
    return chosen[:n]


def classify_mentions(text, lane_names):
    """Which section of a reading each lane is named under.

    Deliberately mechanical. Comparing two readings with a third model would
    reintroduce exactly the problem this is meant to expose -- another single
    model's priors deciding what counts as a difference.
    """
    if not text:
        return {}
    marks = [
        (m.start(), " ".join(m.group(1).upper().split()))
        for m in SECTION_RE.finditer(text)
    ]
    if not marks:
        return {}
    # Segment on every header in document order. A section that appears twice
    # contributes both of its spans rather than only the first.
    bounds = [
        (sec, text[pos:(marks[i + 1][0] if i + 1 < len(marks) else len(text))])
        for i, (pos, sec) in enumerate(marks)
    ]
    out = {}
    for name in lane_names:
        # Word-bounded: substring matching let a lane called `Chair` be claimed
        # by the word "Chairman", and `Local` by the word "local".
        pat = re.compile(rf"\b{re.escape(name)}\b", re.IGNORECASE)
        hits = {sec for sec, chunk in bounds if pat.search(chunk)}
        if hits:
            out[name] = sorted(hits)
    return out


def compare_readings(readings, lane_names):
    """Where the readers disagree about a lane's classification."""
    if len(readings) < 2:
        return []
    maps = [(r["by"], classify_mentions(r.get("text"), lane_names)) for r in readings]
    conflicts = []
    for name in lane_names:
        placements = {by: m.get(name) for by, m in maps}
        distinct = {tuple(v) for v in placements.values() if v}
        if len(distinct) > 1:
            conflicts.append({"lane": name, "placements": placements})
    return conflicts


def estimate_synthesis(lanes, brief, table, defaults, calib, want, count):
    """Worst-case cost of the --diff readers.

    This used to be invisible to the budget. Each reader is sent the brief plus
    *every* lane's answer, so it is the largest single request of the run -- and
    since two readers became the default, it is sent twice. Gating the panel and
    ignoring the synthesis made `--max-spend` a check on the cheap half.

    Bounded before dispatch the same way the panel is: assume every lane fills
    its max_tokens, which is the ceiling its answer can reach.
    """
    readers = pick_synthesizers(lanes, want, count)
    if not readers:
        return 0.0
    body_chars = sum(
        float(l.get("max_tokens", defaults.get("max_tokens", 2000)))
        * chars_per_token(l.get("model"), calib)
        for l in lanes
    )
    prompt_chars = min(len(brief), 4000) + body_chars + len(SYNTH_PROMPT)
    total = 0.0
    for r in readers:
        pin, pout = lane_prices(r, table)
        if not (pin or pout):
            continue
        in_tok = prompt_chars / chars_per_token(r.get("model"), calib)
        # synthesize() raises a reader's ceiling to at least 1500; match it.
        out_tok = max(float(r.get("max_tokens", defaults.get("max_tokens", 2000))), 1500)
        total += in_tok * pin + out_tok * pout
    return total


def synthesize(results, brief, cfg, lanes, keys, prices, count=2,
               sems=None, lock=None, spent=None, deadline=None, pacers=None, retries=1):
    """Ask N lanes to report where the others diverged (issues #6, #8).

    Reading N full answers does not scale, and disagreement is the actual
    product. This is opt-in because it is NOT neutral: a synthesizer is itself
    one model with its own priors deciding what counts as a disagreement. It is
    a reading aid, not a verdict -- which is why the raw answers are still
    written to the transcript.

    Two readers rather than one, because a single reading hides its own bias:
    with one you cannot tell a real split from that model's taste in splits.
    Where two independent readers place the same lane differently, the reading
    is doing the work rather than the evidence. That comparison is mechanical on
    purpose -- handing it to a third model would just move the problem.

    Prefers free lanes so the convenience does not quietly cost money.
    """
    answered = [r for r in results if r.get("answer")]
    if len(answered) < 2:
        return None, "need at least 2 answers to compare"

    chosen = pick_synthesizers(lanes, cfg.get("synthesizer"), max(1, int(count)))
    if not chosen:
        return None, "no lane available to synthesize"

    body = "\n\n".join(f"### {r['lane']} ({r['model'] or r['harness']})\n{r['answer']}"
                        for r in answered)
    ask_text = SYNTH_PROMPT.format(n=len(answered), brief=brief.strip()[:4000], answers=body)

    # Route readers through ask() rather than calling the transports directly.
    # Going around it meant synthesis ignored the per-vendor semaphore (so it
    # could overrun a single-slot local server), ignored rpm pacing, ignored the
    # deadline, and -- worst -- never added its tokens to `spent`, so the run's
    # reported cost omitted its largest request.
    def read(lane):
        synth_lane = {**lane, "max_tokens": max(int(lane.get("max_tokens", 2000)), 1500),
                      "personality": None}
        return ask(synth_lane, ask_text, keys, retries, deadline,
                   sems if sems is not None else {}, lock or threading.Lock(),
                   spent if spent is not None else [0.0],
                   lane_prices(lane, prices), pacers)

    readings, errors = [], []
    with cf.ThreadPoolExecutor(max_workers=len(chosen)) as pool:
        for lane, fut in [(l, pool.submit(read, l)) for l in chosen]:
            r = fut.result()          # ask() never raises; it reports via "error"
            if r.get("answer"):
                readings.append({"by": lane["name"], "text": r["answer"]})
            else:
                errors.append(f"{lane['name']}: {r.get('error') or 'empty answer'}")

    if not readings:
        return None, f"synthesis failed ({'; '.join(errors)})"

    names = [r["lane"] for r in answered]
    return {
        "readings": readings,
        "conflicts": compare_readings(readings, names),
        "errors": errors,
    }, None


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("brief", nargs="*")
    ap.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    ap.add_argument("--lanes")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-spend", type=float)
    ap.add_argument("--no-transcript", action="store_true")
    ap.add_argument("--diff", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip())
        return 0

    cfg = load_config(a.config)
    lanes = [l for l in cfg["lanes"] if l.get("active", True)]
    if a.lanes:
        want = {n.strip().lower() for n in a.lanes.split(",")}
        lanes = [l for l in lanes if l["name"].lower() in want]
        if not lanes:
            die(f"--lanes matched nothing in {a.config}")

    if a.list:
        for l in lanes:
            route = l["harness"]
            where = l.get("base_url") or l.get("command") or ""
            print(f"  [{route:<4}] {l['name']:<18} {str(l.get('vendor') or '-'):<14} "
                  f"{str(l.get('model') or '-'):<42} {where}")
        print(f"\n  {len(lanes)} active lane(s). No calls made.")
        return 0

    prompt = sys.stdin.read() if a.brief[:1] == ["-"] else " ".join(a.brief)
    if not prompt.strip():
        die("empty brief")

    budget = a.max_spend if a.max_spend is not None else cfg.get("budget_usd")
    deadline = time.time() + cfg["deadline_seconds"] if cfg.get("deadline_seconds") else None
    keys = fetch_keys(lanes)
    prices = load_pricing(lanes)

    # Refuse BEFORE spending, not after. A budget checked only on the way out
    # reports an overrun; it does not prevent one.
    calib = load_calibration()
    defaults = cfg.get("defaults") or {}
    estimate = estimate_run(lanes, prompt, prices, defaults, calib)
    if a.diff:
        # The readers are dispatched from inside this run, so their cost belongs
        # in the gate that decides whether to dispatch at all.
        estimate += estimate_synthesis(lanes, prompt, prices, defaults, calib,
                                       cfg.get("synthesizer"),
                                       int(cfg.get("synthesizers", 2)))
    if budget is not None and estimate > budget:
        die(
            f"estimated worst case ${estimate:.4f} exceeds budget ${budget:.2f} — refusing to dispatch\n"
            f"  raise --max-spend, drop lanes with --lanes, or lower max_tokens"
        )

    sems = build_semaphores(lanes, int(cfg.get("concurrency", 8)))
    # Concurrency bounds how many are in flight; rpm bounds how fast they start.
    pacers = build_pacers(lanes)

    lock, spent = threading.Lock(), [0.0]
    t0 = time.time()
    with cf.ThreadPoolExecutor(max_workers=max(len(lanes), 1)) as pool:
        results = list(pool.map(
            lambda l: ask(l, prompt, keys, int(cfg.get("retries", 1)), deadline, sems, lock,
                          spent, lane_prices(l, prices), pacers),
            lanes,
        ))

    answered = [r for r in results if r["answer"]]

    # Fold this run's real prompt_tokens back in, so the next pre-flight
    # estimate is measured rather than assumed.
    record_calibration(results, prompt, lanes)

    # Convergence between lanes that turn out to be the same model is an echo,
    # not evidence. Never fatal -- a deliberate duplicate is a legitimate thing
    # to want -- but it must not be silent, because it is invisible in the
    # answers themselves.
    collisions = lineage_collisions(results, lanes)

    synth = None
    if a.diff:
        synth, synth_err = synthesize(results, prompt, cfg, lanes, keys, prices,
                                      count=int(cfg.get("synthesizers", 2)),
                                      sems=sems, lock=lock, spent=spent,
                                      deadline=deadline, pacers=pacers,
                                      retries=int(cfg.get("retries", 1)))

    if not a.no_transcript:
        TRANSCRIPT_DIR.mkdir(parents=True, exist_ok=True)
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        path = TRANSCRIPT_DIR / f"{stamp}.json"
        path.write_text(json.dumps(
            {"brief": prompt, "results": results, "synthesis": synth,
             "collisions": collisions}, indent=2))

    if a.json:
        print(json.dumps({"results": results, "synthesis": synth} if a.diff else results, indent=2))
    elif a.diff:
        if synth:
            for r in synth["readings"]:
                print(f"\n{'=' * 74}\nWHERE THEY DIVERGE  (read by {r['by']})\n{'=' * 74}")
                print(r["text"])
            # Two readers exist so the reading's own bias is visible. Where they
            # place the same lane differently, that is the synthesizer talking,
            # not the panel -- go read that lane's raw answer.
            if synth["conflicts"]:
                print(f"\n{'=' * 74}\nTHE READERS DISAGREE\n{'=' * 74}")
                for c in synth["conflicts"]:
                    where = "  ".join(
                        f"{by}={'/'.join(sec) if sec else 'unmentioned'}"
                        for by, sec in c["placements"].items()
                    )
                    print(f"  {c['lane']:<18} {where}")
                print("\n  These are classification disputes between the readers, not\n"
                      "  findings. Read those lanes' raw answers in the transcript.")
            elif len(synth["readings"]) > 1:
                print(f"\n  Both readers classified every lane the same way.")
            for e in synth.get("errors") or []:
                print(f"\n  !! reader failed — {e}", file=sys.stderr)
            n = len(synth["readings"])
            print(f"\n  -- {n} lane{'s' if n != 1 else ''} reading the others, not a verdict."
                  f" raw answers in the transcript.")
        else:
            print(f"\n  !! {synth_err}", file=sys.stderr)
    else:
        for r in results:
            # served_by was captured on every http response and never shown.
            # Who actually answered is the evidence for the independence claim.
            via = f"  via {r['served_by']}" if r.get("served_by") else ""
            print(f"\n{'=' * 74}\n{r['lane']}  ({r['model'] or r['harness']})"
                  f"{via}  {r['seconds']}s")
            print("=" * 74)
            print(r["answer"] if r["answer"] else f"  !! {r['error']}")
            if r.get("truncated"):
                print("\n  !! TRUNCATED — hit max_tokens; raise it for this lane")
        print(f"\n{'=' * 74}")
        print(f"{len(answered)}/{len(results)} lanes answered in {time.time() - t0:.1f}s")
        if spent[0] or estimate:
            print(f"spend: ${spent[0]:.4f} actual  (est. worst case ${estimate:.4f})")
        if not a.no_transcript:
            print(f"transcript: {path}")
        for r in results:
            if not r["answer"]:
                print(f"  FAILED  {r['lane']}: {r['error']}")
        # Next to the summary rather than above the answers: a warning printed
        # before the reader has seen anything is a warning they scroll past.
        if collisions:
            print(f"\n  LANES THAT ARE NOT INDEPENDENT", file=sys.stderr)
            for c in collisions:
                how = "declared lineage" if c["kind"] == "lineage" else "answered from"
                print(f"    {', '.join(c['lanes'])} — {how} {c['detail']}",
                      file=sys.stderr)
            print("    Agreement between these is an echo, not convergence.",
                  file=sys.stderr)

    # Backstop only -- the pre-flight gate above is what actually protects the
    # budget. This catches an estimate that was too optimistic.
    if budget is not None and spent[0] > budget:
        print(f"\n!! spend ${spent[0]:.4f} exceeded budget ${budget:.2f}", file=sys.stderr)
        return 2
    # A silent lane is the bug this tool exists to eliminate, so partial
    # delivery is a failure, not a pass.
    return 0 if len(answered) == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
