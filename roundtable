#!/usr/bin/env python3
"""
roundtable — put one question to a panel of independent models, in parallel.

Each lane is a different model, answering the same brief without seeing the
others. The product is *disagreement*: where independently-trained models land
in the same place, that convergence means something; where they split, that is
where you look.

Design notes worth reading before changing anything:

  * There are no long-lived processes. A lane is one HTTP request or one
    short-lived subprocess. An abandoned run cannot keep billing, because there
    is nothing left running to bill.
  * There is no delivery step. Answers come back in the response or the lane
    failed. Nothing can "succeed" into a place nobody reads.
  * `harness`, not `model`, decides cost. See CLI lanes below.

Usage:
    roundtable "the brief"
    cat brief.md | roundtable -
    roundtable --lanes Auditor,Builder "the brief"
    roundtable --list
    roundtable --json > answers.json
    roundtable --config PATH
    roundtable --max-spend 0.50
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import datetime as dt
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("roundtable: PyYAML is required — pip install pyyaml")

DEFAULT_CONFIG = Path.home() / ".config" / "flatline-roundtable" / "FlatlineRoundtable.yaml"
TRANSCRIPT_DIR = Path.home() / ".local" / "share" / "flatline-roundtable" / "transcripts"

# Keys a lane's `extra_body` must never set: they define the request itself, and
# silently overwriting them turns a config typo into a call you did not intend.
EXTRA_BODY_DENY = {"model", "messages", "stream", "max_tokens"}

# Scrubbed from every CLI lane's environment.
#
# THIS IS LOAD-BEARING. `claude -p` authenticates against a Max/Pro subscription
# via OAuth and costs nothing -- but ONLY if ANTHROPIC_API_KEY is unset. If it is
# present in the ambient shell, the CLI bills prepaid console credits instead,
# which are billed separately from the subscription. A free lane silently becomes
# a paid one, with no error and no visible difference in the output.
#
# The same shape applies to the other vendors' CLIs.
SCRUB_ENV = (
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
)


def die(msg: str) -> "NoReturn":  # noqa: F821
    sys.exit(f"roundtable: {msg}")


# --------------------------------------------------------------------------- #
# config
# --------------------------------------------------------------------------- #
def load_config(path: Path) -> dict:
    if not path.exists():
        die(
            f"no config at {path}\n"
            f"  copy FlatlineRoundtable.yaml.example there and edit it, "
            f"or pass --config PATH"
        )
    try:
        cfg = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as e:
        die(f"{path} is not valid YAML: {e}")
    if not isinstance(cfg.get("lanes"), list) or not cfg["lanes"]:
        die(f"{path} defines no lanes")

    defaults = cfg.get("defaults") or {}
    seen: set[str] = set()
    lanes = []
    for i, raw in enumerate(cfg["lanes"]):
        if not isinstance(raw, dict):
            die(f"lane #{i + 1} is not a mapping")
        lane = {**defaults, **raw}
        name = lane.get("name")
        if not name:
            die(f"lane #{i + 1} has no name")
        if name in seen:
            die(f"duplicate lane name {name!r} — names must be unique")
        seen.add(name)

        harness = lane.get("harness")
        if harness not in ("http", "cli"):
            die(f"{name}: harness must be 'http' or 'cli', got {harness!r}")
        if harness == "http":
            for req in ("model", "base_url"):
                if not lane.get(req):
                    die(f"{name}: http lane needs {req}")
        else:
            if not lane.get("command"):
                die(f"{name}: cli lane needs a command")
            if not lane.get("args"):
                die(f"{name}: cli lane needs args (use '{{prompt}}' or stdin: true)")

        bad = EXTRA_BODY_DENY & set((lane.get("extra_body") or {}).keys())
        if bad:
            die(f"{name}: extra_body may not set {', '.join(sorted(bad))}")
        lanes.append(lane)
    cfg["lanes"] = lanes
    return cfg


# --------------------------------------------------------------------------- #
# secrets
# --------------------------------------------------------------------------- #
def fetch_keys(lanes: list[dict]) -> dict[str, str]:
    """Resolve every pass entry ONCE, before fan-out.

    Doing this inside the worker threads instead means N concurrent `pass show`
    calls hitting one gpg-agent. If the store is locked that either serialises
    behind a single pinentry or, in a non-tty context, storms and fails. Resolve
    up front, deduped, while we are still single-threaded and can report one
    clear error instead of N identical ones.
    """
    entries = {l["key_entry"] for l in lanes if l.get("key_entry")}
    if not entries:
        return {}
    if not shutil.which("pass"):
        die(
            "lanes reference pass entries but `pass` is not installed.\n"
            "  install it, or remove key_entry from those lanes"
        )
    keys: dict[str, str] = {}
    for entry in sorted(entries):
        try:
            p = subprocess.run(
                ["pass", "show", entry], capture_output=True, text=True, timeout=30
            )
        except subprocess.TimeoutExpired:
            die(f"`pass show {entry}` timed out — is gpg-agent waiting on a passphrase?")
        if p.returncode != 0:
            die(
                f"no pass entry {entry!r}\n"
                f"  create it with:  pass insert {entry}"
            )
        # pass returns the whole file; the secret is the first line. Taking the
        # blob would put trailing metadata into an Authorization header.
        first = p.stdout.splitlines()[0].strip() if p.stdout.strip() else ""
        if not first:
            die(f"pass entry {entry!r} is empty")
        keys[entry] = first
    return keys


# --------------------------------------------------------------------------- #
# transport
# --------------------------------------------------------------------------- #
def http_lane(lane: dict, prompt: str, key: str | None, retries: int) -> dict:
    body = {
        "model": lane["model"],
        "max_tokens": lane.get("max_tokens", 2000),
        "messages": (
            ([{"role": "system", "content": lane["personality"]}] if lane.get("personality") else [])
            + [{"role": "user", "content": prompt}]
        ),
    }
    if lane.get("temperature") is not None:
        body["temperature"] = lane["temperature"]
    body.update(lane.get("extra_body") or {})

    url = lane["base_url"].rstrip("/") + "/chat/completions"
    headers = {"Content-Type": "application/json"}
    if key:
        # In-process only. Never argv -- argv is world-readable via ps.
        headers["Authorization"] = f"Bearer {key}"

    attempt = 0
    while True:
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=lane.get("timeout", 300)) as r:
                data = json.load(r)
            if "error" in data:
                raise RuntimeError(str(data["error"])[:300])
            choice = data["choices"][0]
            return {
                "answer": (choice["message"].get("content") or "").strip(),
                "finish_reason": choice.get("finish_reason"),
                "served_by": data.get("provider"),
                "usage": data.get("usage"),
            }
        except urllib.error.HTTPError as e:
            retry_after = e.headers.get("Retry-After") if e.headers else None
            transient = e.code >= 500 or e.code == 429
            if transient and attempt < retries:
                attempt += 1
                # Honour Retry-After rather than hammering a rate-limited vendor.
                time.sleep(min(float(retry_after), 30) if retry_after and retry_after.isdigit() else 3 * attempt)
                continue
            raise RuntimeError(f"HTTP {e.code}: {e.read()[:200].decode(errors='replace')}") from None
        except urllib.error.URLError as e:
            if attempt < retries:
                attempt += 1
                time.sleep(3 * attempt)
                continue
            raise RuntimeError(f"connection failed: {e.reason}") from None
        except TimeoutError:
            # Deliberately NOT retried. The request may well have completed and
            # billed on the vendor side; a blind retry double-charges a metered
            # lane to produce an answer we already paid for.
            raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s") from None


def cli_lane(lane: dict, prompt: str) -> dict:
    """Run a subscription-backed CLI in one-shot mode.

    Two things here are not decoration:

    1. The child gets a scrubbed environment (see SCRUB_ENV) so an API key in the
       ambient shell cannot silently convert this free lane into a billed one.
    2. start_new_session=True puts the child in its own process group so a
       timeout can kill the whole tree. A plain subprocess timeout leaves a hung
       CLI (or one sitting at a login prompt) orphaned and running -- which is
       precisely the failure this tool was built to eliminate.
    """
    env = {k: v for k, v in os.environ.items() if k not in SCRUB_ENV}
    env["NO_COLOR"] = "1"

    cmd, stdin_text = [], None
    for arg in lane["args"]:
        if arg == "{prompt}":
            cmd.append(prompt)
        elif arg == "{personality}":
            cmd.append(lane.get("personality", ""))
        else:
            cmd.append(arg)
    if lane.get("stdin"):
        stdin_text = prompt
        cmd = [a for a in cmd if a != prompt]
    if lane.get("personality") and not any("{personality}" in a for a in lane["args"]):
        text = f"{lane['personality']}\n\n---\n\n{prompt}"
        if stdin_text is not None:
            stdin_text = text
        else:
            cmd = [lane["personality"] + "\n\n---\n\n" + a if a == prompt else a for a in cmd]

    proc = subprocess.Popen(
        [lane["command"], *cmd],
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
        start_new_session=True,
    )
    try:
        out, err = proc.communicate(stdin_text, timeout=lane.get("timeout", 300))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        proc.wait(timeout=10)
        raise RuntimeError(f"timed out after {lane.get('timeout', 300)}s (process group killed)") from None

    if proc.returncode != 0:
        raise RuntimeError(f"{lane['command']} exit {proc.returncode}: {err.strip()[:200]}")
    # Shell profiles and CLI update banners pollute stdout. Drop obvious
    # non-answer noise rather than trusting the stream to be clean.
    lines = [l for l in out.splitlines() if not l.strip().startswith(("🕐", "\x1b"))]
    text = "\n".join(lines).strip()
    if not text:
        raise RuntimeError("produced no output")
    return {"answer": text, "finish_reason": "stop", "served_by": lane["command"], "usage": None}


# --------------------------------------------------------------------------- #
# run
# --------------------------------------------------------------------------- #
def ask(lane, prompt, keys, retries, deadline, sems, lock, spent):
    started = time.time()
    result = {
        "lane": lane["name"],
        "model": lane.get("model"),
        "vendor": lane.get("vendor"),
        "harness": lane["harness"],
        "answer": None,
        "error": None,
        "finish_reason": None,
    }
    sem = sems.get(lane.get("vendor") or lane["name"])
    try:
        if deadline and time.time() > deadline:
            raise RuntimeError("global deadline passed before dispatch")
        with sem:
            if lane["harness"] == "cli":
                out = cli_lane(lane, prompt)
            else:
                key = keys.get(lane["key_entry"]) if lane.get("key_entry") else None
                out = http_lane(lane, prompt, key, retries)
        result.update(out)
        if not result["answer"]:
            result["error"] = "empty answer"
        # A clipped answer is a silent failure: it reads as complete and is not.
        if result.get("finish_reason") == "length":
            result["truncated"] = True
        if out.get("usage") and lane.get("price_per_mtok"):
            tok = (out["usage"] or {}).get("total_tokens") or 0
            with lock:
                spent[0] += tok / 1_000_000 * float(lane["price_per_mtok"])
    except Exception as e:  # noqa: BLE001 — a lane failing must never kill the run
        result["error"] = str(e)
    result["seconds"] = round(time.time() - started, 1)
    return result


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("brief", nargs="*")
    ap.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    ap.add_argument("--lanes")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--max-spend", type=float)
    ap.add_argument("--no-transcript", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip())
        return 0

    cfg = load_config(a.config)
    lanes = [l for l in cfg["lanes"] if l.get("active", True)]
    if a.lanes:
        want = {n.strip().lower() for n in a.lanes.split(",")}
        lanes = [l for l in lanes if l["name"].lower() in want]
        if not lanes:
            die(f"--lanes matched nothing in {a.config}")

    if a.list:
        for l in lanes:
            route = l["harness"]
            where = l.get("base_url") or l.get("command") or ""
            print(f"  [{route:<4}] {l['name']:<18} {str(l.get('vendor') or '-'):<14} "
                  f"{str(l.get('model') or '-'):<42} {where}")
        print(f"\n  {len(lanes)} active lane(s). No calls made.")
        return 0

    prompt = sys.stdin.read() if a.brief[:1] == ["-"] else " ".join(a.brief)
    if not prompt.strip():
        die("empty brief")

    budget = a.max_spend if a.max_spend is not None else cfg.get("budget_usd")
    deadline = time.time() + cfg["deadline_seconds"] if cfg.get("deadline_seconds") else None
    keys = fetch_keys(lanes)

    # Per-vendor caps: a single-slot local llama.cpp will queue every concurrent
    # request past its own timeout if we fan out against it blindly.
    default_cc = int(cfg.get("concurrency", 8))
    sems: dict[str, threading.Semaphore] = {}
    for l in lanes:
        gid = l.get("vendor") or l["name"]
        sems.setdefault(gid, threading.Semaphore(int(l.get("concurrency", default_cc))))

    lock, spent = threading.Lock(), [0.0]
    t0 = time.time()
    with cf.ThreadPoolExecutor(max_workers=max(len(lanes), 1)) as pool:
        results = list(pool.map(
            lambda l: ask(l, prompt, keys, int(cfg.get("retries", 1)), deadline, sems, lock, spent),
            lanes,
        ))

    answered = [r for r in results if r["answer"]]
    if not a.no_transcript:
        TRANSCRIPT_DIR.mkdir(parents=True, exist_ok=True)
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        path = TRANSCRIPT_DIR / f"{stamp}.json"
        path.write_text(json.dumps({"brief": prompt, "results": results}, indent=2))

    if a.json:
        print(json.dumps(results, indent=2))
    else:
        for r in results:
            print(f"\n{'=' * 74}\n{r['lane']}  ({r['model'] or r['harness']})  {r['seconds']}s")
            print("=" * 74)
            print(r["answer"] if r["answer"] else f"  !! {r['error']}")
            if r.get("truncated"):
                print("\n  !! TRUNCATED — hit max_tokens; raise it for this lane")
        print(f"\n{'=' * 74}")
        print(f"{len(answered)}/{len(results)} lanes answered in {time.time() - t0:.1f}s")
        if spent[0]:
            print(f"estimated spend: ${spent[0]:.4f}")
        if not a.no_transcript:
            print(f"transcript: {path}")
        for r in results:
            if not r["answer"]:
                print(f"  FAILED  {r['lane']}: {r['error']}")

    if budget and spent[0] > budget:
        print(f"\n!! spend ${spent[0]:.4f} exceeded budget ${budget:.2f}", file=sys.stderr)
        return 2
    # A silent lane is the bug this tool exists to eliminate, so partial
    # delivery is a failure, not a pass.
    return 0 if len(answered) == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
