# Tests and CI have no gpg-agent. This names a FILE holding the key, never the
# key itself: an env var carrying the value would leak into every child process
# and every `ps e`.
DB_KEY_FILE_ENV = "ROUNDTABLE_DB_KEY_FILE"
KCV_PLAINTEXT = b"flatline-roundtable-kcv"
