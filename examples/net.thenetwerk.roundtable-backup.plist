<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily roundtable store backup to telesto (#110). A timer that starts a
  one-shot script, so nothing stays resident.

  Edit the two paths below, then:
    cp examples/net.thenetwerk.roundtable-backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net.thenetwerk.roundtable-backup.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>net.thenetwerk.roundtable-backup</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/YOU/source/repos/FlatlineRoundtable/scripts/backup-telesto.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>45</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOU/.local/state/flatline-roundtable/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/.local/state/flatline-roundtable/backup.log</string>
  </dict>
</plist>
